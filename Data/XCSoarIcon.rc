// Minimal resource file for Windows SDL builds: the application icon
// (Explorer / taskbar).  Artwork is generated from Data/graphics/logo.svg
// (or logo_red.svg when XCSOAR_TESTING is set).

#define IDI_XCSOAR 101

#ifdef XCSOAR_TESTING
IDI_XCSOAR ICON DISCARDABLE "graphics/logo_red.ico"
#else
IDI_XCSOAR ICON DISCARDABLE "graphics/logo.ico"
#endif
