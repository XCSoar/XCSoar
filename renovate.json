{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "semanticCommits": "disabled",
  "timezone": "UTC",
  "schedule": ["* 0-5 * * 1"],
  "prHourlyLimit": 2,
  "prConcurrentLimit": 5,
  "commitMessageTopic": "{{{depName}}}",
  "commitMessageExtra": "to {{{newVersion}}}",
  "prBodyTemplate": "{{{table}}}\n\n---\n\nAutomated update by [Renovate](https://github.com/renovatebot/renovate).",
  "ignorePaths": [
    "output/**",
    "lib/glm/**",
    "android/ioio/**",
    "android/UsbSerial/**"
  ],
  "minimumReleaseAge": "3 days",
  "separateMajorMinor": true,
  "git-submodules": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Bundled libraries in libs.py (monthly, one PR per library)",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["build/python/build/libs.py"],
      "schedule": ["* 0-5 1 * *"],
      "commitMessagePrefix": "build/python/build/libs.py:"
    },
    {
      "description": "Boost headers in libboost.mk (monthly). The checksum is not updated",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["build/libboost.mk"],
      "schedule": ["* 0-5 1 * *"],
      "commitMessagePrefix": "build/libboost.mk:",
      "commitMessageTopic": "Boost"
    },
    {
      "description": "curl tags are curl-8_14_1",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["curl/curl"],
      "versioning": "regex:^curl-(?<major>\\d+)_(?<minor>\\d+)_(?<patch>\\d+)$"
    },
    {
      "description": "OpenSSL tags are openssl-3.1.7",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["openssl/openssl"],
      "versioning": "regex:^openssl-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "description": "libsodium tags are 1.0.20-RELEASE",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["jedisct1/libsodium"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-RELEASE$"
    },
    {
      "description": "SDL tags are release-2.30.0",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["libsdl-org/SDL"],
      "versioning": "regex:^release-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "description": "simple_usbmodeswitch tags are v1.0",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["felixhaedicke/simple_usbmodeswitch"],
      "versioning": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)(?:\\.(?<patch>\\d+))?$"
    },
    {
      "description": "Group GitHub Actions updates (weekly)",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions",
      "commitMessagePrefix": ".github/workflows:",
      "commitMessageTopic": "GitHub Actions",
      "commitMessageExtra": ""
    },
    {
      "description": "Python doc dependencies (weekly)",
      "matchManagers": ["pip_requirements"],
      "groupName": "Python dependencies",
      "groupSlug": "python-deps",
      "commitMessagePrefix": "doc/requirements.txt:",
      "commitMessageTopic": "Python dependencies",
      "commitMessageExtra": ""
    },
    {
      "description": "Group Rust dependencies (weekly)",
      "matchManagers": ["cargo"],
      "groupName": "Rust dependencies",
      "groupSlug": "rust-deps",
      "commitMessagePrefix": "build:",
      "commitMessageTopic": "Rust dependencies",
      "commitMessageExtra": ""
    },
    {
      "description": "Docker base images (weekly)",
      "matchManagers": ["dockerfile"],
      "commitMessagePrefix": "build:"
    },
    {
      "description": "Separate PRs for major version updates",
      "matchUpdateTypes": ["major"],
      "groupName": null
    },
    {
      "description": "Patch updates bypass minimum release age",
      "matchUpdateTypes": ["patch"],
      "minimumReleaseAge": null
    },
    {
      "description": "Git submodules: only android/ioio, lib/glm, and android/UsbSerial are tracked",
      "matchManagers": ["git-submodules"],
      "matchDepNames": ["!android/ioio", "!lib/glm", "!android/UsbSerial"],
      "enabled": false
    },
    {
      "description": "android/ioio follows ytai/ioio master, which has no releases. Each update needs a test with an IOIO board, so it is only listed in the Dependency Dashboard and opened from there",
      "matchManagers": ["git-submodules"],
      "matchDepNames": ["android/ioio"],
      "dependencyDashboardApproval": true,
      "minimumReleaseAge": null,
      "commitMessagePrefix": "android/ioio:",
      "commitMessageTopic": "ytai/ioio",
      "commitMessageExtra": "to {{{newDigestShort}}}"
    },
    {
      "description": "lib/glm follows g-truc/glm master. A bump changes the OpenGL maths used by the renderer, so it is only listed in the Dependency Dashboard and opened from there",
      "matchManagers": ["git-submodules"],
      "matchDepNames": ["lib/glm"],
      "dependencyDashboardApproval": true,
      "minimumReleaseAge": null,
      "commitMessagePrefix": "lib/glm:",
      "commitMessageTopic": "g-truc/glm",
      "commitMessageExtra": "to {{{newDigestShort}}}"
    },
    {
      "description": "android/UsbSerial follows XCSoar/UsbSerial branch 6.1.0+xcsoar, a fork of felHR85/UsbSerial with local fixes. The branch name is valid semver and the repo has a 6.1.0 tag, so allowedVersions keeps Renovate on this branch. Each update needs a test with a USB serial adapter, so it is only listed in the Dependency Dashboard and opened from there",
      "matchManagers": ["git-submodules"],
      "matchDepNames": ["android/UsbSerial"],
      "allowedVersions": "/^6\\.1\\.0\\+xcsoar$/",
      "dependencyDashboardApproval": true,
      "minimumReleaseAge": null,
      "commitMessagePrefix": "android/UsbSerial:",
      "commitMessageTopic": "XCSoar/UsbSerial",
      "commitMessageExtra": "to {{{newDigestShort}}}"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "GitHub tarball pin in libs.py: repo, release tag, sha256. URLs are built from the tag. shortcut: netcdf-c releases ship no tarball, so a bump keeps the old sha256; replace it in that PR",
      "managerFilePatterns": ["/^build/python/build/libs\\.py$/"],
      "matchStrings": [
        "\"(?<depName>[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)\", \"(?<currentValue>[^\"]+)\",\\n    \"(?<currentDigest>[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "github-release-attachments",
      "packageNameTemplate": "{{{depName}}}",
      "autoReplaceStringTemplate": "\"{{{depName}}}\", \"{{{newValue}}}\",\n    \"{{{newDigest}}}\"",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Boost release in libboost.mk. Tags are boost-1.92.0. The makefile builds both URLs from BOOST_VERSION. shortcut: archives.boost.io publishes the sha256 in boost_<version>.tar.bz2.json, and this rule does not read it; replace BOOST_SHA256 from that file before merging",
      "managerFilePatterns": ["/^build/libboost\\.mk$/"],
      "matchStrings": [
        "BOOST_VERSION = (?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "boostorg/boost",
      "packageNameTemplate": "boostorg/boost",
      "extractVersionTemplate": "^boost-(?<version>\\d+\\.\\d+\\.\\d+)$",
      "autoReplaceStringTemplate": "BOOST_VERSION = {{{newValue}}}",
      "versioningTemplate": "semver"
    }
  ]
}
