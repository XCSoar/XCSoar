+
+/* Implementing this method makes UIKit use the scene-based life cycle. */
+- (UISceneConfiguration *)application:(UIApplication *)application configurationForConnectingSceneSession:(UISceneSession *)connectingSceneSession options:(UISceneConnectionOptions *)options API_AVAILABLE(ios(13.0))
+{
+    UISceneConfiguration *config = [[UISceneConfiguration alloc] initWithName:@"SDLSceneConfiguration" sessionRole:connectingSceneSession.role];
+    config.delegateClass = [self class];
+    return config;
+}
+
+- (void)scene:(UIScene *)scene willConnectToSession:(UISceneSession *)session options:(UISceneConnectionOptions *)connectionOptions API_AVAILABLE(ios(13.0))
+{
+    /* UIKit may use another instance of this class as the scene delegate */
+    SDLUIKitDelegate *delegate = [SDLUIKitDelegate sharedAppDelegate];
+
+    if ([scene isKindOfClass:[UIWindowScene class]]) {
+        /* the launch screen was created before the scene existed */
+        delegate->launchWindow.windowScene = (UIWindowScene *)scene;
+    }
+
+    /* run SDL_main now that SDL_CreateWindow() can find the scene */
+    [delegate performSelector:@selector(postFinishLaunch) withObject:nil afterDelay:0.0];
+}
+
+#endif /* SDL_UIKIT_SCENE_LIFECYCLE */
