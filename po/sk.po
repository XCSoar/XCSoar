msgstr "12 vľavo + 3 vpravo + vário (na šírku)"

#, no-c-format
msgid "5 Right (Square)"
msgstr "5 Vpravo (štvorec)"

#, no-c-format
msgid "10 Bottom or Right"
msgstr "12 dole alebo vpravo"

#, no-c-format
msgid "12 Bottom or Right"
msgstr "12 dole alebo vpravo"

#, no-c-format
msgid "10 Top or Left"
msgstr "12 hore alebo dole"

#, no-c-format
