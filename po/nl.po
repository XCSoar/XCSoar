msgstr "Centreren"

#, no-c-format
msgid "Center the status message boxes."
msgstr "Centreer de status berichtvensters."

#, no-c-format
msgid "Show status message boxes in the top left corner."
msgstr "Toon de status berichtvensters in de linker boven hoek."

#, no-c-format
msgid "Box"
msgstr "Kader"

#, no-c-format
msgid "Draws boxes around each InfoBox."
msgstr "Tekent een kader om elke InfoBox."

#, no-c-format
