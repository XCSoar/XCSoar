msgid "Task unchanged"
msgstr "Задачата е непроменена"

msgid "Revert Changes"
msgstr "Върни промените"

msgid "Edit Point"
msgstr "Редактиране на точка"

msgid "Make Finish"
msgstr "Задай като финал"

msgid "Reverse"
msgstr "Обърни"

