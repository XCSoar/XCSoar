msgid "Top left (avoid InfoBoxes)"
msgstr "Горе вляво (избягва инфо-полетата)"

#, no-c-format
msgid "Top right (avoid InfoBoxes)"
msgstr "Горе вдясно (избягва инфо-полетата)"

#, no-c-format
msgid "Bottom left (avoid InfoBoxes)"
msgstr "Долу вляво (избягва инфо-полетата)"

#, no-c-format
msgid "Bottom right (avoid InfoBoxes)"
msgstr "Долу вдясно (избягва инфо-полетата)"

#, no-c-format
msgid "Center top (avoid InfoBoxes)"
msgstr "Горе по средата (избягва инфо-полетата)"

#, no-c-format
