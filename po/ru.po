msgstr "Ограничение частоты SkySight; продолжение через %u с…"

#, c-format
msgid "SkySight connection failed; retrying in %u seconds..."
msgstr "Ошибка соединения SkySight; повтор через %u с…"

#, c-format
msgid "SkySight preload completed with %u failures."
msgstr "Предзагрузка SkySight завершена с %u ошибками."

#, c-format
msgid "SkySight offline cache ready: %u files."
msgstr "Офлайн-кэш SkySight готов: %u файлов."

#, c-format
msgid "SkySight cache finished: %u of %u files ready, %u failed."
msgstr "Кэш SkySight завершён: готово %u из %u файлов, ошибок %u."

