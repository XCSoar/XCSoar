msgstr "Расстояние до выбранной точки. Для ААТ задачи, это расстояние до цели в пределах ААТ сектора."

#, no-c-format
msgid "Circle diameter"
msgstr "Диаметр спирали"

#, no-c-format
msgid "Circle D"
msgstr "Диаметр спирали"

#, no-c-format
