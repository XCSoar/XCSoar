msgctxt "Button"
msgid "Clear downloaded data"
msgstr "Очистить загруженные данные"

msgid "SkySight is unavailable."
msgstr "SkySight недоступен."

#, c-format
msgid "SkySight rate limit reached; continuing in %u seconds."
msgstr "Достигнут лимит частоты SkySight; продолжение через %u с."

msgid "SkySight downloads resumed."
msgstr "Загрузки SkySight возобновлены."

msgid "Loading SkySight forecast steps..."
msgstr "Загрузка шагов прогноза SkySight…"

#, c-format
msgid "SkySight forecasts: %u of %u available..."
