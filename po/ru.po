msgstr "Диаметр спирали. Отображает оцениваемый диаметр спирали и времени полета полного круга. Полезно для оценки наилучшего режима термического полёта планера при различных нагрузках на крыло."

#, no-c-format
msgid "Distance takeoff"
msgstr "Расстояние от старта (взлёта)"

#, no-c-format
msgid "Takeoff Dist"
msgstr "Расстояние от старта (взлёта)"

#, no-c-format
msgid "Distance to where take-off was detected."
msgstr "Расстояние до места, где был старт."

#, no-c-format
msgid "Contest speed"
msgstr "Старт. скорость"

#, no-c-format
msgid "Cont Speed"
msgstr "Скорость"

#, no-c-format
msgid "Instantaneous evaluation of the flown speed according to the configured contest rule set."
msgstr "Мгновенная оценка расстояния в соответствии с настроенным On-Line соревновательным набором правил."

#, no-c-format
