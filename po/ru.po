msgid "Average cross-country speed while on current task over the last hour, not compensated for altitude."
msgstr "Средняя скорость по маршруту во время упражнения, не скомпенсированная по высоте."

#, no-c-format
msgid "Next distance (nominal)"
msgstr "Следующая расстояние (номинальное)"

#, no-c-format
msgid "WP Dist-N"
msgstr "Следующая расстояние (номинальное)"

