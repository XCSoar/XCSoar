msgstr "стрелка, указывающая на выбранный узел. Также показывается имя узла и расстояние до него. Используется оптимизированная позиция активного узла в текущей задаче, центр выбранного узла назначения или цель внутри сектора AAT для задач AAT."

#, no-c-format
msgid "Next waypoint arrival time (ground speed)"
msgstr "Время прибытия на следующий узел (скорость над землей)"

#, no-c-format
msgid "WP ETA VMG"
msgstr "ВП ETA VMG"

#, no-c-format
msgid "Estimated arrival time at next waypoint, assuming current ground speed is maintained."
msgstr "Предполагаемое время достижения след точки маршрута при сохранении текущей скорости относительно земли."

#, no-c-format
msgid "Percentage non-circling climb"
msgstr "Процент набора"

#, no-c-format
msgid "% Str Climb"
msgstr "% Набора"

