msgid "Vario trace"
msgstr "Трэк вариометра"

#, no-c-format
msgid "Vario Trace"
msgstr "Трэк вариометра"

#, no-c-format
msgid "Trace of vertical speed, as reported by the GPS, or the intelligent vario total energy vario value if connected to one."
msgstr "Запись скороподъемности по GPS или электронного варио."

