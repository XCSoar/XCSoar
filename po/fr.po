msgstr "Suivre le global"

#, no-c-format
msgid "Use the same light/dark mode as the overall UI."
msgstr "Utiliser le même mode clair/sombre que l'interface générale."

#, no-c-format
msgid "Light"
msgstr "Clair"

#, no-c-format
msgid "Always use dark text on a light InfoBox background."
msgstr "Toujours utiliser un texte sombre sur un fond clair d'InfoBox."

#, no-c-format
