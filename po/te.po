#, no-c-format
msgid "Thermal average"
msgstr "థర్మల్ ప్రామాణిక వేగం"

#, no-c-format
msgid "TC Avg"
msgstr "టాస్క్ ఆవేజ్"

#, no-c-format
msgid ""
"Altitude gained/lost in the current thermal, divided by time spent "
