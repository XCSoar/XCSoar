msgstr "క్రమాన్వయంలో ఉన్న క్రమాన్వయ గతి, ఎత్తు నిషేధాలకు సమానంగా విభజించబడలేదు"

#, no-c-format
msgid "Final distance"
msgstr "ఫైనల్ దూరం"

#, no-c-format
msgid "Fin Dist"
msgstr "ఫైనల్ దూరం"

#, no-c-format
msgid "Distance to finish around remaining turn points."
msgstr "రవాణాకు మిగిలిన తరువాతి టర్న్ పాయింట్ల వద్ద ఉన్న దూరం"

#, no-c-format
msgid "Terrain elevation"
