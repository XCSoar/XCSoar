msgstr "Hedef hız anlık"

#, no-c-format
msgid "Team Dist"
msgstr ""
"Anlık cross-country hız, yükseklik için korelasyon yapılmıştır. Pirker anlık "
"cross-country hızına eşdeğerdir."

#, no-c-format
msgid "Range to the team aircraft location at the last reported team code."
msgstr "Ev yolculuğunda anlık uzaklık"

#, no-c-format
msgid "Speed task instantaneous"
msgstr "Hız görevi anlık"

#, no-c-format
msgid "V Task Inst"
msgstr "V Görev Anlık"

#, no-c-format
msgid ""
"Instantaneous cross-country speed while on current task, compensated for "
