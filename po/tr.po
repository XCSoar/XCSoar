msgstr "AAT maksimum mesafe"

#, no-c-format
msgid "AAT Dmax"
msgstr "AAT Dmax"

#, no-c-format
msgid "Assigned Area Task maximum distance possible for remainder of task."
msgstr ""
"Atanmış Alan Görevi için kalıcı görev süresinde mümkün olan maksimum mesafe."

#, no-c-format
msgid "AAT min. distance"
msgstr "AAT minimum mesafe"

#, no-c-format
msgid "AAT Dmin"
msgstr "AAT Yönetimi"

#, no-c-format
msgid "Assigned Area Task minimum distance possible for remainder of task."
msgstr ""
"Atanmış Alan Görevi için kalıcı görev süresinde mümkün olan minimum mesafe."

