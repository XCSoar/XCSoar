msgstr "Merkezle"

#, no-c-format
msgid "Center the status message boxes."
msgstr "Durum mesaj kutularını merkezle."

#, no-c-format
msgid "Show status message boxes in the top left corner."
msgstr "Durum mesaj kutularını sol üst köşede göster."

#, no-c-format
msgid "Box"
msgstr "Çerçeve"

#, no-c-format
msgid "Draws boxes around each InfoBox."
msgstr "Her InfoBox'u etrafında çerçeve çizin."

#, no-c-format
msgid "Tab"
msgstr "Tuş"

#, no-c-format
msgid "Draws a tab at the top of the InfoBox across the title."
msgstr "InfoBox'un başlığına destekleyen cihazlarda tab çizgisi ekleyin."

#, no-c-format
msgid "Shaded"
msgstr "Şeffaf"

#, no-c-format
msgid "Glass"
