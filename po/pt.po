msgstr "Carta VFR Italiana Avioportolano"

#, no-c-format
msgid "German DFS VFR Chart"
msgstr "Carta VFR DFS Alemã"

#, no-c-format
msgid "French SIA VFR Chart"
msgstr "Carta VFR SIA Francesa"

#, no-c-format
msgid "High Contrast"
msgstr "Contraste do Terreno"

#, no-c-format
msgid "High Contrast low lands"
msgstr "Contraste do Terreno"

#, no-c-format
msgid "Very low lands"
msgstr "Planícies"

msgid "Terrain colors"
msgstr "Cores do Terreno"

msgid "Defines the color ramp used in terrain rendering."
msgstr "Define a paleta de cores usada na renderização do terreno."

#, no-c-format
msgid "Sun"
msgstr "Sol"

msgid "Slope shading"
msgstr "Sombreamento"

msgid "Terrain contrast"
msgstr "Contraste do Terreno"

msgid "Defines the amount of Phong shading in the terrain rendering. Use large values to emphasise terrain slope, smaller values if flying in steep mountains."
