msgid "Preload Selected"
msgstr "Iš anksto įkelti pasirinktus"

msgid "Select SkySight Layers"
msgstr "Pasirinkti SkySight sluoksnius"

#, no-c-format
msgctxt "Button"
msgid "Select all"
msgstr "Pasirinkti visus"

#, no-c-format
msgctxt "Button"
msgid "Select none"
msgstr "Nieko nepasirinkti"

msgid "Some selected layers couldn't be added (the list may be full)."
msgstr ""
"Kai kurių pasirinktų sluoksnių nepavyko pridėti (sąrašas gali būti pilnas)."

msgid "Couldn't preload forecast data."
msgstr "Nepavyko iš anksto įkelti prognozės duomenų."

msgid "Couldn't apply the selected SkySight layer to the current page."
msgstr ""
"Nepavyko pritaikyti pasirinkto SkySight sluoksnio dabartiniam puslapiui."

#, c-format
msgid "Cache %u forecast files for %u selected SkySight layers for offline use?"
msgstr ""
"Talpykloje saugoti %u prognozės failų %u pasirinktiems SkySight sluoksniams "
"naudoti neprisijungus?"

#, c-format
msgid "Discover and cache all forecasts for %u selected SkySight layers for offline use?"
msgstr ""
"Atrasti ir talpykloje saugoti visas %u pasirinktų SkySight sluoksnių "
"prognozes naudoti neprisijungus?"

msgid "SkySight offline cache"
msgstr "SkySight neprisijungusi talpykla"

#, c-format
msgid "%s in %u files"
msgstr "%s iš %u failų"

#, c-format
msgid "Delete %s of cached SkySight data? This includes any recently downloaded forecasts and map tiles. The active layer may be downloaded again if Auto update is enabled."
msgstr ""
"Ištrinti %s talpykloje saugomų SkySight duomenų? Įskaitant neseniai "
"atsisiųstas prognozes ir žemėlapio plyteles. Jei įjungtas automatinis "
"atnaujinimas, aktyvus sluoksnis gali būti atsisiųstas vėl."

msgid "Clear SkySight cache"
msgstr "Išvalyti SkySight talpyklą"

#, c-format
msgid "Deleted %s in %u files."
msgstr "Ištrinta %s iš %u failų."

msgid "Automatically download missing or newer SkySight data for the current map page. Manual preload remains available."
msgstr ""
"Automatiškai atsisiųsti trūkstamus ar naujesnius SkySight duomenis "
"dabartiniam žemėlapio puslapiui. Rankinis išankstinis įkėlimas lieka "
"prieinamas."

#, no-c-format
msgctxt "Setting"
msgid "Cache"
msgstr "Talpykla"

msgid "Total disk space used by the SkySight cache folder."
msgstr "Bendras disko plotas, kurį naudoja SkySight talpyklos aplankas."

#, no-c-format
msgctxt "Button"
msgid "Clear downloaded data"
msgstr "Išvalyti atsisiųstus duomenis"

msgid "SkySight is unavailable."
msgstr "SkySight nepasiekiamas."

#, c-format
msgid "SkySight rate limit reached; continuing in %u seconds."
msgstr "Pasiektas SkySight greičio limitas; tęsiama po %u s."

msgid "SkySight downloads resumed."
msgstr "SkySight atsisiuntimai atnaujinti."

msgid "Loading SkySight forecast steps..."
msgstr "Įkeliami SkySight prognozės žingsniai…"

#, c-format
msgid "SkySight forecasts: %u of %u available..."
msgstr "SkySight prognozės: prieinama %u iš %u…"

#, c-format
msgid "SkySight rate limited; continuing in %u seconds..."
msgstr "SkySight greičio apribojimas; tęsiama po %u s…"

#, c-format
msgid "SkySight connection failed; retrying in %u seconds..."
msgstr "SkySight ryšys nepavyko; kartojama po %u s…"

#, c-format
msgid "SkySight preload completed with %u failures."
msgstr "SkySight išankstinis įkėlimas baigtas su %u klaidomis."

#, c-format
msgid "SkySight offline cache ready: %u files."
msgstr "SkySight neprisijungusi talpykla paruošta: %u failų."

#, c-format
msgid "SkySight cache finished: %u of %u files ready, %u failed."
msgstr "SkySight talpykla baigta: paruošta %u iš %u failų, nepavyko %u."

