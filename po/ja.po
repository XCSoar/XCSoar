msgstr "FAI　三角コース"

#, no-c-format
msgid "FAI out and return"
msgstr "FAI 往復"

#, no-c-format
msgid "FAI goal"
msgstr "FAIゴール"

#, no-c-format
msgid "Racing"
msgstr "レース（競技）タスク"

#, no-c-format
