msgstr "Planare evitând teren"

#, no-c-format
msgid "Arrival height considering terrain avoidance. Requires \"Reach mode: Turning\" in \"Glide Computer > Route\" settings."
msgstr "Înălțimea la sosire care lucrează cu evitarea terenului. Requer \"Mod de ajuns: Tocmire\" în setările \"Computerul de planare > Rute\"."

#, no-c-format
msgid "Straight & terrain glide"
msgstr "Planare straight & evitând teren"

#, no-c-format
msgid "Both arrival heights are displayed. Requires \"Reach mode: Turning\" in \"Glide Computer > Route\" settings."
msgstr "Ambele înălțiuri la sosire sunt afișate. Requer \"Mod de ajuns: Tocmire\" în setările \"Computerul de planare > Rute\"."

#, no-c-format
msgid "Required GR & terrain glide"
msgstr "Planare raport de planare necesar & evitând teren"

#, no-c-format
msgid "Both Required glide ratio and terrain avoidance height are displayed. Requires \"Reach mode: Turning\" in \"Glide Computer > Route\" settings."
msgstr "Ambele rapoarte de planare necesare și înălțimea pentru a evita teren sunt afișate. Requer \"Mod de ajuns: Tocmire\" în setările \"Computerul de planare > Rute\"."

msgid "Determines how arrival height is displayed in waypoint labels"
msgstr "Determină cum este afișată înălțimea la sosire în etichetele punctelor de ruta"

