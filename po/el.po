msgid "Trace of average climb rate each turn in circling, based of the reported GPS altitude, or vario if available."
msgstr "Μεταθέτημα μέσης τάχυτητας κύκλων, βασισμένη στο αναφερόμενο όρισμα GPS, ή βαριόμετρο αν είναι διαθέσιμο."

#, no-c-format
msgid "Climb band"
msgstr "Μπάντα Αύξησης"

#, no-c-format
msgid "Climb Band"
msgstr "Μπάντα Αύξησης"

