msgid "Trace of vertical speed of air-mass, equal to vario value less the glider's estimated sink rate."
msgstr "Σχεδίαση τάχυτητας κύκλων αέριου, ίση με το βαριόμετρο λιγότερο την εκτιμημένη τάχυτητα σπάσης του πλοίου."

#, no-c-format
msgid "Thermal climb trace"
msgstr "Σχεδίαση αύξησης θερμικού"

#, no-c-format
msgid "TC Trace"
msgstr "ΤΑ Μεταθέτημα"

