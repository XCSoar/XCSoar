msgid "Contiguous period during which the aircraft has been below the task start maximum height."
msgstr "Συνεχείς περιόδους κατά τις οποίες η αεροσκάφος βρίσκεται κάτω από τη μέγιστη πλάτη της δοκιμασίας."

#, no-c-format
msgid "Task time to go (ground speed)"
msgstr "Χρόνος-πορεία της δοκιμασίας (ήβη)"

#, no-c-format
msgid "Fin ETE VMG"
msgstr "Τελικό ETE VMG"

#, no-c-format
msgid "Estimated time required to complete task, assuming current ground speed is maintained."
msgstr "Προετοιμασία χρόνου που απαιτείται για την ολοκλήρωση της δοκιμασίας, βάζοντας σε μέγιστη την τρέχουσα ηπείρου-βάθος."

#, no-c-format
msgid "Next time to go (ground speed)"
msgstr "Τελικό χρόνο πορεία (ήβη)"

#, no-c-format
msgid "WP ETE VMG"
msgstr "Σημείο διαδρομής ETE VMG"

#, no-c-format
msgid "Estimated time required to reach next waypoint, assuming current ground speed is maintained."
msgstr "Προετοιμασία χρόνου που απαιτείται για την ολοκλήρωση της διαδρομής μέχρι το επόμενο σημείο διαδρομής, βάζοντας σε μέγιστη την τρέχουσα ηπείρου-βάθος."

#, no-c-format
msgid "Attitude indicator"
msgstr "Πλατόματο"

#, no-c-format
msgid "Attitude indicator (artificial horizon) display calculated from flight path, supplemented with acceleration and variometer data if available."
msgstr "Πλατόματο (κύκλωμα) που εκφράζεται από την διαδρομή, συμπληρώνοντας με δεδομένα βίας και βαριομέτρου όταν είναι διθεώρητα."

#, no-c-format
msgid "Nearest airspace horizontal"
msgstr "Εγγύς εναερικός χώρος στον επίπεδο"

#, no-c-format
msgid "Near AS H"
msgstr "Πλάτος AS H"

#, no-c-format
msgid "Horizontal distance to the nearest airspace."
msgstr "Ευρετήριο διαστάσης στον επίπεδο."

#, no-c-format
msgid "Nearest airspace vertical"
msgstr "Εγγύς εναερικός χώρος στο τμήμα"

#, no-c-format
msgid "Near AS V"
msgstr "Πλάτος AS V"

#, no-c-format
msgid "Vertical distance to the nearest airspace. A positive value means the airspace is above you; a negative value means the airspace is below you."
msgstr "Διαστάση που απέχει η πλάτη από τον εγγύς εναερικό χώρο. Μια θετική τιμή σημαίνει ότι ο εναερικός χώρος βρίσκεται πάνω από το αεροσκάφος, ενώ μια αρνητική τιμή σημαίνει ότι ο εναερικός χώρος βρίσκεται κάτω."

#, no-c-format
msgid "Next MC0 altitude difference"
msgstr "Διαφορά πλάτης MC0"

#, no-c-format
msgid "WP MC0 AltD"
msgstr "Σημείο διαδρομής MC0 Δυναμικός Ανύσματος"

#, no-c-format
msgid "Arrival altitude at the next waypoint with MC 0 setting relative to the safety arrival height. For AAT tasks, the target within the AAT sector is used."
msgstr "Υψόμετρο άφιξης στο τελικό Σημείο Στροφής της διαδρομής σε σχέση με το ύψος ασφαλούς άφιξης."

#, no-c-format
