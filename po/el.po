msgstr "Γράφημα μέσης τάχυτητας κύκλων ως συνάρτηση του ανύψωσης (στοιχείο οριζόντιο) για το μέγεθος (στοιχείο κάθετο)."

#, no-c-format
msgid "Task progress"
msgstr "Πρόοδος δοκιμής"

#, no-c-format
msgid "Progress"
msgstr "Πρόοδος"

#, no-c-format
msgid "Clock-like display of distance remaining along task, showing achieved task points."
msgstr "Φρακώδης επισημαντικός χωρίς τον απομένονο απόσταγμα μέχρι τη συνέχεια της δοκιμής, επιδεικνύοντας τους επιτευγμένους σημείους της δοκιμής."

#, no-c-format
msgid "Time under max. start height"
msgstr "Χρόνος υπό τη μέγιστη αρχική πλάτη"

#, no-c-format
msgid "Start Height"
msgstr "Αρχική πλάτη"

