msgid "White"
msgstr "Λευκό"

#, no-c-format
msgid "Sandstone"
msgstr "Σανδόλι"

#, no-c-format
msgid "Pastel"
msgstr "Παστελίδιο"

#, no-c-format
msgid "Italian Avioportolano VFR Chart"
msgstr "Ιταλικό Avioportolano VFR χάρτης"

#, no-c-format
msgid "German DFS VFR Chart"
msgstr "Γερμανικό DFS VFR χάρτης"

#, no-c-format
msgid "French SIA VFR Chart"
msgstr "Φραγμένο SIA VFR Τύπος"

#, no-c-format
msgid "High Contrast"
msgstr "Αντίθεση Εδάφους"

#, no-c-format
msgid "High Contrast low lands"
msgstr "Αντίθεση Εδάφους"

#, no-c-format
msgid "Very low lands"
msgstr "Χαμηλά Εδάφη"

msgid "Terrain colors"
msgstr "Χρώματα Εδάφους"

msgid "Defines the color ramp used in terrain rendering."
msgstr ""
"Ειδοποιεί τη λεωφόρου χρώματο που χρησιμοποιείται στην εκπλήρωση του "
"γεωγραφικού περιβάλλοντός."

#, no-c-format
msgid "Sun"
msgstr "Ηλιος"

msgid "Slope shading"
msgstr "Πίνυμπα σκέλη"

msgid "Terrain contrast"
msgstr "Αντίθεση Εδάφους"

msgid "Defines the amount of Phong shading in the terrain rendering. Use large values to emphasise terrain slope, smaller values if flying in steep mountains."
msgstr "Ειδοποιεί το ποσοστό Phong εξάσκησης στην εκπλήρωση του γεωγραφικού περιβάλλοντός. Χρησιμοποιήστε μεγάλα αξία για να επικεντρώσετε τη σκληρότητα του γεωγραφικού περιβάλλοντος, μικρότερα αξία όταν ξεπερνάτε σκληρές βουνά."

msgid "Terrain brightness"
msgstr "Φωτεινότητα Εδάφους"

msgid "Defines the brightness (whiteness) of the terrain rendering. This controls the average illumination of the terrain."
msgstr "Ειδοποιεί τη φωτοσφάγμα (χυμό) της εκπλήρωσης του γεωγραφικού περιβάλλοντός. Αυτό διαδιέξει το μέσο φωτισμό του γεωγραφικού περιβάλλοντος."

msgid "Contours"
msgstr "Ισοϋψείς"

msgid "Preset"
msgstr "Προεπιλογή"

msgid "Load a set of units."
msgstr "Κατασκευάστε μια σύνθεση μετρημάτων."

msgid "Custom"
msgstr "Δικαιοδοξία"

msgid "My individual set of units."
msgstr "Το δικό μου σύνολο μετρημάτων."

#, no-c-format
msgid "knots"
msgstr "κότες"

msgid "Aircraft/Wind speed"
msgstr "Ταχύτητα ανέμου"

msgid ""
"Units used for airspeed and ground speed. A separate unit is available for "
"task speeds."
msgstr ""
"Μετρήσεις που χρησιμοποιούνται για την αέρια συχνότητα και την επίβαθρη "
"συχνότητα. Υπάρχει μια διασκεδαστική μετρήση για τις συχνότητες του "
"παιχνιδιού."

msgid ""
"Units used for horizontal distances e.g. range to waypoint, distance to go."
msgstr ""
"Μετρήσεις που χρησιμοποιούνται για τις επίπλεους απόστασες, συχνά μέγιστη "
"διαστάση οδού προς σημείο διαδρομής, απόσταση για να φθάσεις."

msgid "Lift"
msgstr "Άνοδο"

msgid "Units used for vertical speeds (variometer)."
msgstr ""
"Μετρήσεις που χρησιμοποιούνται για τις επίπλεους ταχύτητες (βαριόμετρο)."

#, no-c-format
msgid "feet"
msgstr "μέτρα"

#, no-c-format
msgid "meters"
msgstr "μέτρα"

msgid "Units used for altitude and heights."
msgstr "Μετρήσεις που χρησιμοποιούνται για τις ανωτήτες και τις υψόμετρες."

msgid "Units used for temperature."
msgstr "Μονάδες χρησιμοποιείται για την θερμοκρασία."

msgid "Units used for task speeds."
msgstr "Μονάδες χρησιμοποιείται για τις συντομίες των μεγέθους της δουλειάς."

msgid "Units used for pressures."
msgstr "Μονάδες χρησιμοποιείται για τις πίεσες."

msgid "Units used for mass."
msgstr "Μονάδες χρησιμοποιείται για το βάρος."

msgid "Units used for wing loading."
msgstr "Μονάδες χρησιμοποιείται για την επιφανειακή φορτωτικότητα."

msgid "Lat./Lon."
msgstr "Λατ./Λον."

msgid "Units used for latitude and longitude."
msgstr "Μονάδες χρησιμοποιείται για τη λατινική και τη λοντινική."

msgid "Rotation"
msgstr "Προσανατολισμός"

msgid "Unit used for rotation."
msgstr "Μονάδα χρησιμοποιείται για την περιστροφή."

#, no-c-format
msgid "UTC offset"
msgstr "Διάβασμα UTC"

msgid ""
"The UTC offset field allows the UTC local time offset to be specified. The "
"local time is displayed below in order to make it easier to verify the "
"correct offset has been entered."
msgstr ""
"Το πεδίο διάβασμα UTC επιτρέπει να συγκρίνεται το χρόνο του μηχανήματος με "
"τον χρόνο GPS. Το χρόνο της περιοχής εμφανίζεται κάτω για να βοηθήσει στην "
"αποβεβαιώση ότι έχετε εισάγει το σωστό διάβασμα."

msgid "Use GPS time"
msgstr "Χρήση χρόνου GPS"

msgid ""
"If enabled sets the clock of the computer to the GPS time once a fix is set. "
"This is only necessary if your computer does not have a real-time clock with "
"battery backup or your computer frequently runs out of battery power or "
"otherwise loses time."
msgstr ""
"Αν είναι ενεργοποιημένο, καθοδηγεί το ρολόι του υπολογιστή στο χρόνο GPS μια "
"φορά που έχει εκτελεστεί η αποδείξη. Αυτό είναι απαραίτητο μόνο αν το "
"υπολογιστή σας δεν έχει ρολόι προωθημένου χρυσού που είναι συνδεδεμένο με το "
"υπολογιστή ή αλλιώς το υπολογιστή σας διακόπηκε πολύ συχνά και άλλωστε "
"αφίστραζε χρόνο."

#, no-c-format
msgid "Full name"
msgstr "Το όνομα το ενυπνιασμένο"

#, no-c-format
msgid "The full name of each waypoint is displayed."
msgstr "Το ενυπνιασμένο όνομα κάθε σημείου διαδρομής εμφανίζεται."

#, no-c-format
msgid "First word of name"
msgstr "Το πρώτο λόγο του όνοματος"

#, no-c-format
msgid "The first word of the waypoint name is displayed."
msgstr "Το πρώτο λόγο του όνοματος του σημείου διαδρομής εμφανίζεται."

#, no-c-format
msgid "First 3 letters"
msgstr "Τα πρώτα 3 γράμματα"

#, no-c-format
msgid "The first 3 letters of the waypoint name are displayed."
msgstr "Τα πρώτα 3 γράμματα του όνοματος του σημείου διαδρομής εμφανίζονται."

#, no-c-format
msgid "First 5 letters"
msgstr "Τα πρώτα 5 γράμματα"

#, no-c-format
msgid "The first 5 letters of the waypoint name are displayed."
msgstr "Τα πρώτα 5 γράμματα του όνοματος του σημείου διαδρομής εμφανίζονται."

#, no-c-format
msgid "No waypoint name is displayed."
msgstr "Δεν εμφανίζεται ο όνομα του σημείου διαδρομής."

#, no-c-format
msgid "The short name of each waypoint is displayed. If unavailable, the first five letters of the full name are displayed."
msgstr "Η σύντομη ονομασία του σημείου διαδρομής εμφανίζεται. Αν δεν είναι διθέλικη, εμφανίζονται τα πρώτα πέντε γράμματα του βαθμού όντως."

msgid "Label format"
msgstr "Φόρμα σήματος"

msgid "Determines how labels are displayed with each waypoint"
msgstr "Εκπληκτικό μέθοδο εμφάνισης των σήματών με κάθε σημείο διαδρομής"

#, no-c-format
msgid "No arrival height is displayed."
msgstr "Δεν εμφανίζεται η υψόμετρος προσχώρησης."

#, no-c-format
msgid "Straight glide"
msgstr "Ολισθηση μέσω γραμμής"

#, no-c-format
msgid "Straight glide arrival height (no terrain is considered)."
msgstr "Ολισθηση μέσω γραμμής χωρίς ανάγκη επιβολής περιθώριου εμπόδιων."

#, no-c-format
msgid "Terrain avoidance glide"
msgstr "Απόφυγη επιβολής περιθώριου εμπόδιων"

#, no-c-format
msgid "Arrival height considering terrain avoidance. Requires \"Reach mode: Turning\" in \"Glide Computer > Route\" settings."
msgstr "Υψόμετρο προσχώρησης με αξία επιβολής περιθώριου εμπόδιων. Απαιτείται \"Mode: Turning\" στις \"Settings > Route\"."

#, no-c-format
msgid "Straight & terrain glide"
msgstr "Ολισθηση μέσω γραμμής και απόφυγη επιβολής περιθώριου εμπόδιων"

#, no-c-format
msgid "Both arrival heights are displayed. Requires \"Reach mode: Turning\" in \"Glide Computer > Route\" settings."
msgstr "Και τα δύο υψόμετρα προσχώρησης εμφανίζονται. Απαιτείται \"Mode: Turning\" στις \"Settings > Route\"."

#, no-c-format
msgid "Required GR & terrain glide"
msgstr "Ολισθηση μέσω γραμμής και απόφυγη επιβολής περιθώριου εμπόδιων"

#, no-c-format
msgid "Both Required glide ratio and terrain avoidance height are displayed. Requires \"Reach mode: Turning\" in \"Glide Computer > Route\" settings."
msgstr "Και τα δύο υψόμετρα προσχώρησης και απόφυγη επιβολής περιθώριου εμπόδιων εμφανίζονται. Απαιτείται \"Mode: Turning\" στις \"Settings > Route\"."

msgid "Determines how arrival height is displayed in waypoint labels"
msgstr "Εκπληκτικό μέθοδο εμφάνισης του υψομέτρου προσχώρησης στα σήματα διαδρομής"

#, no-c-format
msgid "Rounded rectangle"
msgstr "Συντεταγμένη τετράγωνο"

#, no-c-format
msgid "Outlined"
msgstr "Γραμμακό"

msgid "Label style"
msgstr "Τύπος σήματος"

#, no-c-format
msgid "Task waypoints & airfields"
msgstr "Πινάκια δοκιμασίας και αεροδρόμια"

#, no-c-format
msgid "All waypoints part of a task and all airfields will be displayed."
msgstr "Όλα τα σημεία διαδρομής που είναι μέρος ενός δοκιμαστικού και όλα τα αεροδρόμια εμφανίζονται."

#, no-c-format
msgid "Task waypoints & landables"
msgstr "Πινάκια δοκιμασίας και προσγειώσιμα"

#, no-c-format
msgid "All waypoints part of a task and all landables will be displayed."
msgstr "Όλα τα σημεία διαδρομής που είναι μέρος ενός δοκιμαστικού και όλα τα προσγειώσιμα εμφανίζονται."

#, no-c-format
msgid "Task waypoints"
msgstr "Εργασιακά σημεία"

#, no-c-format
msgid "All waypoints part of a task will be displayed."
msgstr "Όλα τα σημεία διαδρομής που αντιπροσωπεύουν μέρος της εργασίας θα εμφανιστούν."

#, no-c-format
msgid "Purple circle"
msgstr "Κυκλικό σάρκι"

#, no-c-format
msgid "Airports and outlanding fields are displayed as purple circles. If the waypoint is reachable a bigger green circle is added behind the purple one. If the waypoint is blocked by a mountain the green circle will be red instead."
msgstr "Αεροδρόμια και προσγειώσεις εκτός πεδίου εμφανίζονται ως κυκλικά σάρκια μπλάκη. Αν το σημείο διαδρομής είναι διαθέσιμο, πρόσθετο ένα μεγαλύτερο κυκλικό σάρκι χλωρό. Αν το σημείο διαδρομής είναι αποκλεισμένο από βουνό, το κυκλικό σάρκι χλωρό γίνεται κυκλικό σάρκι πυρρό."

#, no-c-format
msgid "B/W"
msgstr "Μαύρο/Πολύμορφο"

#, no-c-format
msgid "Airports and outlanding fields are displayed in white/grey. If the waypoint is reachable the color is changed to green. If the waypoint is blocked by a mountain the color is changed to red instead."
msgstr "Αεροδρόμια και προσγειώσεις εκτός πεδίου εμφανίζονται μαύρη/πολύμορφη. Αν το σημείο διαδρομής είναι διαθέσιμο, το χρώμα αλλάζεται σε χλωρό. Αν το σημείο διαδρομής είναι αποκλεισμένο από βουνό, το χρώμα αλλάζει σε πυρρό."

#, no-c-format
msgid "Traffic lights"
msgstr "Φωτιές κινητήρα"

#, no-c-format
msgid "Airports and outlanding fields are displayed in the colors of a traffic light. Green if reachable, Orange if blocked by mountain and red if not reachable at all."
msgstr "Αεροδρόμια και προσγειώσεις εκτός πεδίου εμφανίζονται σε χρώματα φωτιών κινητήρα. Χλωρό αν διαθέσιμο, οράνιο αν αποκλεισμένο από βουνό και πυρρό αν όχι διαθέσιμο."

msgid "Landable symbols"
msgstr "Στίλοι προσγείωσης"

msgid "Three styles are available: Purple circles (WinPilot style), a high contrast (monochrome) style, or orange. The rendering differs for landable field and airport. All styles mark the waypoints within reach green."
msgstr "Διάθεση τριών στιλ: κυκλικά σάρκια μπλάκη ( stil WinPilot ), υψηλή αντίκατοχτικότητα (μονοχρωματικό) ή πυρρό. Η διαδικασία είναι διαφορετική για προσγείωση και αεροδρόμιο. Όλοι τα στίλ επισημάνουν τα σημεία διαδρομής μέχρι να είναι διαθέσιμα χλωρό."

msgid "Detailed landables"
msgstr "Πληροφορητικές προσγείωσης"

msgid ""
"[Off] Display fixed icons for landables.\n"
"[On] Show landables with variable information like runway length and heading."
msgstr "[Απευθύνεται] Δείξτε σταθερά εικονικά σήματα για τις προσγείωση."

msgid "Landable size"
msgstr "Τάξη προσγείωσης"

msgid "A percentage to select the size landables are displayed on the map."
msgstr "Οι αναλογίες για τη διαδικασία επίσημης εμφάνισης των προσγείωση στο χάρτη."

msgid "Scale runway length"
msgstr "Προσαναλήψη μήκους δρόμου"

msgid ""
"[Off] Display fixed length for runways.\n"
"[On] Scale displayed runway length based on real length."
msgstr "[Απευθύνεται] Δείξτε σταθερό μήκος για τους δρόμους."

msgid "Show thermal locations downloaded from Thermal Information Map (thermalmap.info)."
msgstr "Εμφάνιση θερμικών θέσεων που κατέβασαν από την Thermal Information Map (thermalmap.info)."

msgid "Allow download of declared tasks from Weglide in the Task Manager."
msgstr ""
"Αποδοχή κατέβασμας δήλωσης δραστηριοτήτων από το WeGlide στο Manager των "
"δραστηριοτήτων."

msgid "Automatic Upload"
msgstr "Αυτόματη μεταφόρτωση"

msgid ""
"Asks whether to upload flight to Weglide, after flight is downloaded from "
"external logger."
msgstr ""
"Αsks αν πρέπει να μεταδίδεται η εξέγερση στο WeGlide, μετά την κατέβαση από "
"δεξιό log."

msgid "Take this from your WeGlide Profile. Or set to 0 if not used."
msgstr ""
"Αυτό παίρνεται από το profile WeGlide σας. ή ρίθμιστε 0 αν δεν "
