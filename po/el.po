msgstr ""
"Κώδικας ομάδας τού κυβερνήματος για αυτό το αεροσκάφος. Χρησιμοποιήστε αυτό "
"για να αναφέρεστε σε άλλους μέλες της ομάδας. Ο κώδικας ανατροπής του "
"τελευταίου αεροσκάφους της ομάδας εμφανίζεται πάνω."

#, no-c-format
msgid "Team bearing"
msgstr "Κατεύθυνση Ομάδας"

#, no-c-format
msgid "Team Brng"
msgstr "Σημείο ομάδας"

#, no-c-format
msgid "Bearing to the team aircraft location at the last team code report."
msgstr ""
"Προσβασιμότητα στη θέση του αεροσκάφους της ομάδας που είχε τελευταία "
"αναφέρει ο κώδικας."

#, no-c-format
msgid "Team bearing difference"
msgstr "Διαφορά σημείου ομάδας"

#, no-c-format
msgid "Team BrngD"
msgstr "Διαφορά Σημείου ομάδας (Σημείο ομάδας)"

#, no-c-format
msgid ""
"Relative bearing to the team aircraft location at the last reported team "
