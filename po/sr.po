msgstr "Isprati bar za zavrsni kliz."

#, no-c-format
msgid "Always show final glide bar."
msgstr "Uvezi finalni klizni pravac."

#, no-c-format
msgid "Show final glide bar if approaching final glide range."
msgstr "Uvezi finalni klizni pravac ako se podlaziš finalnom oblasti kliza."

#, no-c-format
msgid "Auto (follow InfoBoxes)"
msgstr "InfoBox nalepiti"

