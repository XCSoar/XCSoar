"Assigned Area Task time remaining. Goes red when time remaining has expired."
msgstr ""
"Affecto-alueen tehtävän jälkivakioaika. Väritys muuttuu punaiseksi kun "
"jäljellä olevan aikaa on kulunut."

#, no-c-format
msgid "AAT max. distance "
msgstr "AAT maksimi etäisyys"

#, no-c-format
msgid "AAT Dmax"
msgstr "AAT Dmax"

#, no-c-format
