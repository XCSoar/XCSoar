msgid ""
"Relative bearing to the team aircraft location at the last reported team "
"code."
msgstr ""
"Relativiivinen kulku kohteeseen viitattujen sijaintiin viime raportoitu "
"koodilla."

#, no-c-format
msgid "Team range"
msgstr "Tiimikaveriin etäisyys"

#, no-c-format
msgid "Team Dist"
msgstr "Etäisyys"

#, no-c-format
msgid "Range to the team aircraft location at the last reported team code."
msgstr ""
"Välilennystä kohteeseen viitattujen sijaintiin viime raportoitu koodilla."

#, no-c-format
msgid "Speed task instantaneous"
msgstr "Nopeus, tehtävän hetkellinen"

#, no-c-format
msgid "V Task Inst"
msgstr "V Tehtävä Inst"

#, no-c-format
msgid ""
"Instantaneous cross-country speed while on current task, compensated for "
"altitude. Equivalent to instantaneous Pirker cross-country speed."
msgstr ""
"Hetkistä maantieteellinen nopeus tehtävän jälkeen, korjattuna korkeudelle. "
"Sama kuin hetkistä Pirkerin maantieteellinen nopeus."

#, no-c-format
msgid "Distance home"
msgstr "Etäisyys kotiin"

#, no-c-format
msgid "Home Dist"
msgstr "Matka kotiin"

#, no-c-format
msgid "Distance to home waypoint (if defined)."
msgstr "Etäisyys kotipisteeseen (mikäli määritetty)."

#, no-c-format
msgid "Speed task achieved"
msgstr "Nopeus, tehtävällä saavutettu"

#, no-c-format
msgid "V Task Ach"
msgstr "V Tehtävä Ach"

#, no-c-format
