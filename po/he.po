msgstr "גובה הגעה למקודה"

#, no-c-format
msgid "Free RAM"
msgstr "זיכרון החופף"

#, no-c-format
msgid "Free RAM as reported by OS."
msgstr "זיכרון החופף כמו מדווח על ידי מערכת ההפעלה."

#, no-c-format
msgid "Flight level"
msgstr "רמת טיסה"

#, no-c-format
msgid "FL"
msgstr "FL"

#, no-c-format
msgid "Pressure Altitude given as Flight Level. If barometric altitude is not available, FL is calculated from GPS altitude, given that the correct QNH is set. In case the FL is calculated from the GPS altitude, the FL label is coloured red."
msgstr "גובה לחץ נתון כגובה טיסה. אם גובה ברומטרי אינו זמין, FL מוצלח מגובה GPS, בהנחה ש-QNH הנכון מוגדר. במקרה שבו FL מוצלח מגובה GPS, התווית FL מוצגת באדום."

#, no-c-format
msgid "Barogram"
msgstr "גרוגרמ"

#, no-c-format
msgid "Trace of altitude during flight."
msgstr "מסלול הגובה במהלך הטיסה."

#, no-c-format
msgid "Vario trace"
msgstr "ווריומטרית מסלול"

#, no-c-format
msgid "Vario Trace"
msgstr "ווריומטרית מסלול"

#, no-c-format
msgid "Trace of vertical speed, as reported by the GPS, or the intelligent vario total energy vario value if connected to one."
msgstr "מסלול מהירות אנכית, כפי שמדידה ה-GPS, או ערך ווריומטר המהירות האנכית של המרחב האווירי אם הוא מחובר."

#, no-c-format
msgid "Netto vario trace"
msgstr "מסלול ווריומטרית נטו"

#, no-c-format
msgid "Netto Trace"
msgstr "מסלול נטו"

#, no-c-format
msgid "Trace of vertical speed of air-mass, equal to vario value less the glider's estimated sink rate."
msgstr "מסלול מהירות אנכית של המרחב האווירי, שווה לערך ווריומטר פחות ריכוז הירידה של הדאון."

#, no-c-format
msgid "Thermal climb trace"
msgstr "מסלול עלה תרמית"

#, no-c-format
msgid "TC Trace"
msgstr "TC מסלול"

#, no-c-format
msgid "Trace of average climb rate each turn in circling, based of the reported GPS altitude, or vario if available."
msgstr "מסלול ממוצע עלה במעגלים, מבוסס על הגובה המדויק של ה-GPS או על ערך ווריומטר אם זמין."

#, no-c-format
msgid "Climb band"
msgstr "קטע עלה"

#, no-c-format
msgid "Climb Band"
msgstr "קטע עלה"

#, no-c-format
