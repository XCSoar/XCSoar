msgstr "Az átlagos emelés változásai az egyes körökben, a GPS magasság vagy ha csatlakoztattak, a variométer alapján."

#, no-c-format
msgid "Climb band"
msgstr "Emelési sáv"

#, no-c-format
msgid "Climb Band"
msgstr "Emelési sáv"

#, no-c-format
msgid "Graph of average circling climb rate (horizontal axis) as a function of altitude (vertical axis)."
msgstr "Átlagos körbeli emelkedés arány ábrája (vonalaxis) függvényében az alapterem magasság (szélességi tengely)."

#, no-c-format
msgid "Task progress"
msgstr "Feladat állapota"

#, no-c-format
msgid "Progress"
msgstr "Állapot"

#, no-c-format
msgid "Clock-like display of distance remaining along task, showing achieved task points."
msgstr "A feladatból hátralevő távolság óraszerű megjelenítése, az elért pontok ábrázolásával."

#, no-c-format
msgid "Time under max. start height"
msgstr "Startmagasság alatt töltött idő"

#, no-c-format
msgid "Start Height"
msgstr "Startmagasság"

#, no-c-format
msgid "Contiguous period during which the aircraft has been below the task start maximum height."
msgstr "Az az összefüggő időtartam, amit a startmagasság alatt töltött a repülő."

#, no-c-format
msgid "Task time to go (ground speed)"
msgstr "SF idő úton ff"

#, no-c-format
msgid "Fin ETE VMG"
msgstr "SF úton ff"

#, no-c-format
msgid "Estimated time required to complete task, assuming current ground speed is maintained."
msgstr "A feladat teljesítéséhez szükséges becsült idő, ha a jelenlegi földfeletti sebességgel számolunk."

#, no-c-format
msgid "Next time to go (ground speed)"
msgstr "FP idő úton ff"

#, no-c-format
msgid "WP ETE VMG"
msgstr "FP úton ff"

#, no-c-format
msgid "Estimated time required to reach next waypoint, assuming current ground speed is maintained."
msgstr "A következő fordulópont eléréséhez szükséges becsült idő, ha a jelenlegi földfeletti sebességgel számolunk."

