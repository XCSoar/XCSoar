msgstr "Alternativni 1"

#, no-c-format
msgid "Altn 1"
msgstr "Alternativni izvor 1"

#, no-c-format
msgid "Name and bearing to the best alternate landing location."
msgstr "Ime i smjer na najbolju alternativnu odlaznicu."

#, no-c-format
msgid "Alternate 2"
msgstr "Alternativni 2"

#, no-c-format
msgid "Altn 2"
msgstr "Alternativni izvor 2"

#, no-c-format
msgid "Name and bearing to the second-best alternate landing location."
msgstr "Ime i smjer na drugo najbolje mjesto za dolazak."

#, no-c-format
msgid "Alternate 1 GR"
msgstr "GR alternativa 1"

