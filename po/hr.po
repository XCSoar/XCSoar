msgid ""
"Trend (or neg. of the variation) of the total required height to complete "
"the task."
msgstr ""
"Trend (ili negativan varijacija) zahtijevane visine za završetak zadatka."

#, no-c-format
msgid "Battery percent"
msgstr "Procenat baterije"

#, no-c-format
msgid ""
"Percentage of device battery remaining (where applicable) and status/voltage "
"of external power supply."
msgstr ""
"Postotak ostvarenog napajanja (kada je dostupno) i status/napon vanjskog "
"napajanja."

#, no-c-format
msgid "Final GR"
msgstr "Konačni GR"

#, no-c-format
msgid "Fin GR"
msgstr "Konačni GR"

