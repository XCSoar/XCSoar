msgstr "Postavlja ponašanje trenutnog zadatka."

msgid "Minimum AAT task time in minutes."
msgstr "Minimalni vrijeme začetka AAT u minutama."

msgid "Arm start manually"
msgstr "Pokreni start ručno"

