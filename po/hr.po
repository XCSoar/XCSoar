msgid "Warning time"
msgstr "Upozori prije"

msgid ""
"This is the time before an airspace incursion is estimated at which the "
"system will warn the pilot."
msgstr ""
"Ovo je vremenski period pre predviđenog pristupa zračnom prostoru u kojem će "
"sustav upozoriti pilota."

msgid "Repetitive sound"
msgstr "Ponavljajući zvuk"

msgid ""
"Enable/disable repetitive warning sound when airspaces warnings dialog is "
"displayed."
msgstr ""
"Omogućivanje/isporušavanje ponavljajućeg upozorenja zvukom kada je prikazano "
"okno upozorenja o zračnim prostirama."

msgid "Acknowledge time"
msgstr "Vrijeme potvrde"

msgid ""
"This is the time period in which an acknowledged airspace warning will not "
"be repeated."
msgstr ""
"Ovo je vremenski period nakon kojeg će biti ponovno ispunjeno upozorenje o "
"zračnom prostoru, ukoliko je priznato."

msgid "Use black outline"
msgstr "Koristi crnu konturu"

msgid ""
"Draw a black outline around each airspace rather than the airspace color."
msgstr ""
"Okružiti svaki zračni prostor crvenom linijom umjesto bojom zračnog prostora."

msgid "Airspace fill mode"
msgstr "Način popunjavanja zračnih prostira"

msgid "Specifies the mode for filling the airspace area."
msgstr "Određuje način popunjavanja područja zračnog prostora."

msgid "Airspace transparency"
msgstr "Transparencija zračnih prostira"

msgid "If enabled, then airspaces are filled transparently."
msgstr "Ako je omogućeno, zračni prostiri će biti ispunjeni transparanatom."

#, no-c-format
msgid "Disable final glide bar."
msgstr "Isporušavanje traka za završni kliz."

#, no-c-format
msgid "Always show final glide bar."
msgstr "Uvijek prikazivanje trake za završni kliz."

#, no-c-format
msgid "Show final glide bar if approaching final glide range."
msgstr ""
"Prikaz trake za završni kliz ako se približavate opsegu završnog kliza."

#, no-c-format
