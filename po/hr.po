msgstr "Prikaži ikone u zavijesnim dijalohovima."

#, no-c-format
msgid "Center"
msgstr "Centar"

#, no-c-format
msgid "Center the status message boxes."
msgstr "Centriraj poručivanja stanja."

#, no-c-format
msgid "Show status message boxes in the top left corner."
msgstr "Prikaži poručivanja stanja na gornjem lijevom kutu."

