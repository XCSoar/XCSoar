#, no-c-format
msgid ""
"FAI rules, allows only FAI start, finish and turn point types, for badges "
"and records. Enables FAI finish height for final glide calculation."
msgstr ""
"Quy tắc FAI, chỉ cho phép sử dụng các điểm bắt đầu, kết thúc và quay vòng "
"của FAI, cho huy hiệu và kỷ lục. Cho phép chiều cao kết thúc của FAI trong "
"tính toán lượn cuối."

#, no-c-format
msgid "FAI rules, path from a start to two turn points and return."
msgstr ""
"Quy tắc FAI, đường bay từ điểm bắt đầu đến hai điểm quay vòng và quay lại."

#, no-c-format
msgid "FAI rules, path from start to a single turn point and return."
msgstr ""
"Quy tắc FAI, đường bay từ điểm bắt đầu đến một điểm quay vòng và quay lại."

#, no-c-format
msgid "FAI rules, path from start to a goal destination."
msgstr "Quy tắc FAI, đường bay từ điểm bắt đầu đến đích mục tiêu."

#, no-c-format
msgid ""
"Racing task around turn points. Can also be used for FAI badge and record "
"tasks. Allows all shapes of observation zones."
msgstr ""
"Nhiệm vụ đua xung quanh các điểm quay vòng. Có thể sử dụng cho cả huy hiệu "
"và kỷ lục của FAI. Cho phép tất cả hình dạng khu vực quan sát."

#, no-c-format
msgid ""
"Task through assigned areas, minimum task time applies. Restricted to "
"cylinder and sector observation zones."
msgstr ""
"Nhiệm vụ thông qua các khu vực đã gán, thời gian nhiệm vụ tối thiểu áp dụng. "
"Giới hạn trong các khu vực quan sát hình trụ và sector."

#, no-c-format
msgid ""
"Modified area task. Task with start, finish and at least one predefined 1 "
"mile cylinder. Pilot can add additional points as needed. Minimum task time "
"applies."
msgstr ""
"Nhiệm vụ khu vực thay đổi. Nhiệm vụ có điểm bắt đầu, kết thúc và ít nhất một "
"cylinder 1 dặm được định trước. Phi công có thể thêm các điểm cần thiết."

#, no-c-format
msgid ""
"Racing task with a mix of assigned areas and turn points, minimum task time "
"applies."
msgstr ""
"Nhiệm vụ đua với sự kết hợp giữa các khu vực đã gán và điểm quay vòng, thời "
"gian nhiệm vụ tối thiểu áp dụng."

#, no-c-format
msgid ""
"Casual touring task, uses start and finish cylinders and FAI sector turn "
"points."
msgstr ""
"Nhiệm vụ du lịch phiêu lưu, sử dụng các cylinder bắt đầu và kết thúc cùng "
"các điểm quay vòng sector của FAI."

#, no-c-format
msgid ""
"A 90-degree sector with 1 km radius. Cross corner edge from inside area to "
"start."
msgstr ""
"Sector 90 độ với bán kính 1 km. Qua góc cạnh bên trong khu vực đến điểm bắt "
"đầu."

#, no-c-format
msgid "A straight line start gate. Cross start gate from inside area to start."
msgstr ""
"Cửa bắt đầu thẳng hàng. Qua cửa bắt đầu từ bên trong khu vực đến điểm bắt "
"đầu."

#, no-c-format
msgid "A cylinder. Exit area to start."
msgstr "Hình trụ. Ra khỏi khu vực để đến điểm bắt đầu."

#, no-c-format
msgid ""
"A 90-degree sector with 'infinite' length sides. Cross any edge, scored from "
"corner point."
msgstr ""
"Một góc 90 độ với các cạnh có chiều dài vô hạn. Chạm vào bất kỳ cạnh nào, "
"được tính từ điểm góc."

#, no-c-format
msgid "A keyhole. Scored from center."
msgstr "Hình chìa khóa. Được tính từ tâm."

#, no-c-format
msgid ""
"(German rules) Any point within 1/2 km of center or 10 km of a 90-degree "
"sector. Scored from center."
msgstr ""
"(Quy tắc Đức) Điểm nằm trong bán kính 1/2 km từ tâm hoặc 10 km từ một góc 90 "
"độ. Được tính từ tâm."

#, no-c-format
msgid ""
"(British rules) Any point within 1/2 km of center or 20 km of a 90-degree "
"sector. Scored from center."
msgstr ""
"(Quy tắc Anh) Điểm nằm trong bán kính 1/2 km từ tâm hoặc 20 km từ một góc 90 "
"độ. Được tính từ tâm."

#, no-c-format
msgid ""
"(British rules) Any point within 1/2 km of center or 10 km of a 180-degree "
"sector. Scored from center."
msgstr ""
"(Quy tắc Anh) Điểm nằm trong bán kính 1/2 km từ tâm hoặc 10 km từ một góc "
"180 độ. Được tính từ tâm."

#, no-c-format
msgid "A cylinder. Any point within area scored from center."
msgstr "Một hình trụ. Điểm nằm trong khu vực được tính từ tâm."

#, no-c-format
msgid "A 1 mile cylinder. Scored by farthest point reached in area."
msgstr ""
"Một hình trụ với bán kính 1 dặm. Được tính bằng điểm xa nhất đạt được trong "
"khu vực."

#, no-c-format
msgid "A cylinder. Scored by farthest point reached in area."
msgstr "Một hình trụ. Được tính bằng điểm xa nhất đạt được trong khu vực."

#, no-c-format
msgid ""
"A sector that can vary in angle and radius. Scored by farthest point reached "
"inside area."
msgstr ""
"Một góc có thể thay đổi về góc và bán kính. Được tính bằng điểm xa nhất đạt "
"được trong khu vực."

#, no-c-format
msgid "A 90-degree sector with 1 km radius. Cross edge to finish."
msgstr "Một góc 90 độ với bán kính 1 km. Chạm vào cạnh để kết thúc."

#, no-c-format
msgid "Cross finish gate line into area to finish."
msgstr "Chạm vào đường biên của cửa đích để kết thúc."

#, no-c-format
msgid "Enter cylinder to finish."
msgstr "Nhập vào hình trụ để kết thúc."

#, no-c-format
msgid ""
"A 180-degree sector with 5 km radius. Exit area in any direction to start."
msgstr ""
"Một góc 180 độ với bán kính 5 km. Ra khỏi khu vực theo bất kỳ hướng nào để "
"bắt đầu."

#, no-c-format
msgid ""
"A sector that can vary in angle, inner and outer radius. Scored by farthest "
"point reached inside area."
msgstr ""
"Một góc có thể thay đổi về góc, bán kính nội và ngoại. Được tính bằng điểm "
"xa nhất đạt được trong khu vực."

#, no-c-format
msgid "A keyhole. Scored by farthest point reached in area."
msgstr "Hình chìa khóa. Được tính bằng điểm xa nhất đạt được trong khu vực."

