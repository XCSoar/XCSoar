msgstr "Tắt thanh lượn cuối tự động."

#, no-c-format
msgid "Always show final glide bar."
msgstr "Luôn hiển thị thanh lượn cuối."

#, no-c-format
msgid "Show final glide bar if approaching final glide range."
msgstr "Hiển thị thanh lượn cuối nếu đang tiếp cận phạm vi lượn cuối."

