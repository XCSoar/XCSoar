#, no-c-format
msgid "Center"
msgstr "Trung tâm"

#, no-c-format
msgid "Center the status message boxes."
msgstr "Trung tâm thông báo trạng thái."

#, no-c-format
msgid "Show status message boxes in the top left corner."
msgstr "Hiển thị hộp thoại thông báo trạng thái ở góc trên bên trái."

#, no-c-format
msgid "Box"
msgstr "Hộp"

#, no-c-format
msgid "Draws boxes around each InfoBox."
msgstr "Vẽ khung quanh mỗi InfoBox."

#, no-c-format
msgid "Tab"
msgstr "Dấu tab"

#, no-c-format
msgid "Draws a tab at the top of the InfoBox across the title."
msgstr "Vẽ thanh tab ở trên của InfoBox qua tiêu đề."

#, no-c-format
msgid "Shaded"
msgstr "Có bóng"

#, no-c-format
msgid "Glass"
msgstr "Kính"

#, no-c-format
msgid "Use the system-wide setting"
msgstr "Sử dụng cài đặt hệ thống"

#, no-c-format
msgid "Black text on white background"
msgstr "Văn bản đen trên nền trắng"

#, no-c-format
msgid "White text on black background"
msgstr "Văn bản trắng trên nền đen"

#, no-c-format
msgid "Follow global"
msgstr "Theo dõi toàn cầu"

#, no-c-format
msgid "Use the same light/dark mode as the overall UI."
msgstr "Sử dụng cùng chế độ sáng/tối như giao diện người dùng tổng thể."

#, no-c-format
msgid "Light"
msgstr "Ánh sáng"

#, no-c-format
msgid "Always use dark text on a light InfoBox background."
msgstr "Luôn sử dụng văn bản tối trên nền InfoBox sáng."

#, no-c-format
msgid "Dark"
msgstr "Tối tăm"

#, no-c-format
msgid "Always use light text on a dark InfoBox background."
msgstr "Luôn sử dụng văn bản sáng trên nền InfoBox tối."

msgid "Full screen"
msgstr "Màn hình toàn màn hình"

msgid "Run XCSoar in full screen mode"
msgstr "Chạy XCSoar ở chế độ toàn màn hình"

msgid "Display orientation"
msgstr "Hướng hiển thị"

msgid "Rotate the display on devices that support it."
msgstr "Quay màn hình trên các thiết bị hỗ trợ."

msgid "Dark mode"
msgstr "Chế độ tối"

msgid "InfoBox geometry"
msgstr "Hình dạng InfoBox"

msgid ""
"A list of possible InfoBox layouts. Do some trials to find the best for your "
"screen size."
msgstr ""
"Một danh sách các bố cục InfoBox có thể. Hãy thử nghiệm để tìm ra bố cục tốt "
"nhất cho kích thước màn hình của bạn."

msgid "InfoBox title size"
msgstr "Kích cỡ tiêu đề InfoBox"

msgid "Zoom factor for InfoBox title and comment text"
msgstr "Hệ số phóng to cho tiêu đề và văn bản chú thích InfoBox"

msgid "Tab dialog style"
msgstr "Kiểu đối thoại tab"

msgid "Message display"
msgstr "Hiển thị thông báo"

msgid "Colored InfoBoxes"
msgstr "InfoBox có màu sắc"

msgid ""
"If true, certain InfoBoxes will have coloured text. For example, the active "
"waypoint InfoBox will be blue when the glider is above final glide."
msgstr ""
"Nếu đúng, một số InfoBox sẽ có chữ màu sắc. Ví dụ, InfoBox điểm đường bay "
"hiện tại sẽ là xanh dương khi tàu lượn ở trên lượn cuối."

msgid "InfoBox theme"
msgstr "Chủ đề hộp thông tin"

msgid "InfoBox border"
msgstr "Rìa InfoBox"

msgid "Show Menu button"
msgstr "Hiển thị nút Menu"

msgid "Show the Menu button"
msgstr "Hiển thị nút Menu"

msgid "Show Zoom button"
msgstr "Hiển thị nút Zoom"

msgid "Show the Zoom button"
msgstr "Hiển thị nút Zoom"

msgid "Cursor zoom"
msgstr "Phóng to con trỏ"

msgid "Cursor zoom factor"
msgstr "Hệ số phóng to của con trỏ"

msgid "Invert cursor color"
msgstr "Đảo ngược màu con trỏ"

msgid "Enable black cursor"
msgstr "Kích hoạt con trỏ đen"

#, no-c-format
msgid "Start only"
msgstr "Chỉ bắt đầu"

msgid "Pilot name"
msgstr "Tên phi công"

msgid "Name of the pilot in command, recorded in the IGC flight log."
msgstr "Tên của phi công chỉ huy, được ghi trong nhật ký chuyến bay của IGC."

msgid "CoPilot name"
msgstr "Tên phi công"

msgid "The co-pilot name recorded in the IGC flight log."
msgstr "Tên phi công phụ được ghi trong nhật ký chuyến bay của IGC."

msgid "Crew weight default"
msgstr "Trọng lượng phi hành đoàn mặc định"

msgid ""
"Default for all weight loaded to the glider beyond the empty weight and "
"besides the water ballast."
msgstr ""
"Trọng lượng mặc định cho tất cả trọng lượng được tải lên tàu lượn ngoài "
"trọng lượng rỗng và bên cạnh balat nước."

msgid "Time step cruise"
msgstr "Bước thời gian bay tốc độ"

msgid "This is the time interval between logged points when not circling."
msgstr "Đây là khoảng thời gian giữa các điểm ghi log khi không quay vòng."

msgid "Time step circling"
msgstr "Bước đếm khi quay vòng"

msgid "This is the time interval between logged points when circling."
msgstr "Đây là khoảng thời gian giữa các điểm ghi log khi quay vòng."

msgid "Auto. logger"
msgstr "Ghi log tự động"

msgid ""
"Enables the automatic starting and stopping of logger on takeoff and landing "
"respectively. Disable when flying paragliders."
msgstr ""
"Cho phép bắt đầu và dừng ghi log tự động khi cất cánh và hạ cánh tương ứng. "
"Tắt khi bay paraglider."

msgid ""
"Enable the NMEA logger on startup? If this option is disabled, the NMEA "
"logger can still be started manually."
msgstr ""
"Bật ghi log NMEA khi khởi động? Nếu tùy chọn này bị tắt, ghi log NMEA vẫn có "
"thể được khởi động thủ công."

msgid "Log book"
msgstr "Sổ ghi chép"

msgid "Logs each start and landing."
msgstr "Ghi lại mỗi lần cất cánh và hạ cánh."

msgid "Logger ID"
msgstr "ID nhật ký"

msgid "The three-letter logger ID used in the IGC filename."
msgstr "ID trình ghi nhật ký gồm ba chữ cái được sử dụng trong tên tệp IGC."

#, no-c-format
msgid ""
"The moving map display will be rotated so the glider's track is oriented up."
msgstr ""
"Hình ảnh bản đồ di chuyển sẽ được xoay sao cho đường bay của tàu lượn hướng "
"lên trên."

#, no-c-format
msgid "Heading up"
msgstr "Hướng lên"

#, no-c-format
msgid ""
"The moving map display will be rotated so the glider's heading is oriented "
"up."
msgstr ""
"Hình ảnh bản đồ di chuyển sẽ được xoay sao cho hướng đầu tàu lượn hướng lên "
"trên."

#, no-c-format
msgid ""
"The moving map display will always be orientated north to south and the "
"glider icon will be rotated to show its course."
msgstr ""
"Hình ảnh bản đồ di chuyển luôn được định hướng từ Bắc sang Nam và biểu tượng "
"tàu lượn sẽ được xoay để chỉ hướng đường bay."

#, no-c-format
msgid "Target up"
msgstr "Mục tiêu lên"

#, no-c-format
msgid ""
"The moving map display will be rotated so the navigation target is oriented "
"up."
msgstr ""
"Hình ảnh bản đồ di chuyển sẽ được xoay sao cho mục tiêu dẫn đường hướng lên "
"trên."

#, no-c-format
msgid "Wind up"
msgstr "Hướng gió lên"

#, no-c-format
msgid ""
"The moving map display will be rotated so the wind is always oriented up to "
"down. (can be useful for wave flying)"
msgstr ""
"Hình ảnh bản đồ di chuyển sẽ luôn được định hướng theo hướng gió từ trên "
"xuống dưới (có thể hữu ích cho bay sóng)."

#, no-c-format
msgid "Disable adjustments."
msgstr "Tắt điều chỉnh."

#, no-c-format
msgid "Track"
msgstr "Đường đi"

#, no-c-format
msgid "Use a recent average of the ground track as basis."
msgstr "Sử dụng trung bình gần đây của đường đi mặt đất làm cơ sở."

#, no-c-format
msgid "Target"
msgstr "Điểm đường bay hiện tại"

#, no-c-format
msgid "Use the current target waypoint as basis."
msgstr "Sử dụng điểm đường bay hiện tại làm cơ sở."

msgid "Cruise orientation"
msgstr "Hướng di chuyển"

msgid "Determines how the screen is rotated with the glider"
msgstr "Xác định cách màn hình được xoay theo hướng tàu lượn."

msgid "Circling orientation"
msgstr "Hướng quay vòng"

msgid "Determines how the screen is rotated with the glider while circling"
msgstr "Xác định cách màn hình được xoay khi quay vòng."

msgid "Circling zoom"
msgstr "Phóng to vòng lượn"

msgid ""
"If enabled, then the map will zoom in automatically when entering circling "
"mode and zoom out automatically when leaving circling mode."
msgstr ""
"Nếu kích hoạt, bản đồ sẽ tự động phóng to khi chuyển sang chế độ quay vòng "
"và tự động thu nhỏ khi rời khỏi chế độ quay vòng."

msgid "Map shift reference"
msgstr "Tham chiếu dịch chuyển bản đồ"

msgid "Determines what is used to shift the glider from the map center"
msgstr "Xác định gì được sử dụng để dịch chuyển tàu lượn từ trung tâm bản đồ."

msgid "Glider position offset"
msgstr "Khoảng cách vị trí tàu lượn"

msgid ""
"Defines the location of the glider drawn on the screen in percent from the "
"screen edge."
msgstr ""
"Định nghĩa vị trí của tàu lượn được vẽ trên màn hình theo phần trăm từ mép "
"màn hình."

msgid "Max. auto zoom distance"
msgstr "Khoảng cách phóng to tự động tối đa"

msgid "The upper limit for auto zoom distance."
msgstr "Giới hạn trên cho khoảng cách phóng to tự động."

msgid "Distinct page zoom"
msgstr "Zoom trang riêng biệt"

msgid "Maintain one map zoom level on each page."
msgstr "Giữ một mức zoom bản đồ duy nhất trên mỗi trang."

#, no-c-format
msgid "Map (north-up)"
msgstr "Bản đồ (trên hướng bắc)"

msgid "Main area"
msgstr "Khu vực chính"

msgid "Specifies what should be displayed in the main area."
msgstr "Xác định điều gì nên được hiển thị trong khu vực chính."

#, no-c-format
msgid "Displays either the Circling, Cruise, or Final glide InfoBoxes."
msgstr "Hiển thị InfoBox quay vòng, di chuyển hoặc lượn cuối."

#, no-c-format
msgid "Show fullscreen (no InfoBoxes)"
msgstr "Hiển thị toàn màn hình (không có InfoBox)"

msgid "InfoBoxes"
msgstr "Thông báo"

msgid "Specifies which InfoBoxes should be displayed on this page."
msgstr "Chỉ định các InfoBox nào nên được hiển thị trên trang này."

#, no-c-format
msgid "For cruise mode. Displayed when 'Auto' is selected and glider is below final glide altitude."
msgstr "Đối với chế độ bay xa. Hiển thị khi 'Tự động' được chọn và tàu lượn ở dưới độ cao lượn cuối."

#, no-c-format
msgid "For circling mode. Displayed when 'Auto' is selected and glider is circling."
msgstr "Đối với chế độ quay vòng. Hiển thị khi 'Tự động' được chọn và tàu lượn đang quay vòng."

#, no-c-format
msgid "For final glide mode. Displayed when 'Auto' is selected and glider is above final glide altitude."
msgstr "Đối với chế độ lượn cuối. Hiển thị khi 'Tự động' được chọn và tàu lượn ở trên độ cao lượn cuối."

#, no-c-format
msgid "A custom InfoBox set"
msgstr "Một tập InfoBox tùy chỉnh"

#, no-c-format
msgid "Nothing"
msgstr "Không có gì"

#, no-c-format
msgid "Cross section"
msgstr "Cắt ngang"

msgid "Bottom area"
msgstr "Khu vực dưới cùng"

#, no-c-format
msgid "Neither airspace nor terrain is used for route planning."
msgstr "Không sử dụng không phận hay địa hình để lên kế hoạch hành trình."

#, no-c-format
msgid "Routes will avoid terrain."
msgstr "Hành trình sẽ tránh địa hình."

#, no-c-format
msgid "Routes will avoid airspace."
msgstr "Hành trình sẽ tránh không phận."

#, no-c-format
msgid "Routes will avoid airspace and terrain."
msgstr "Hành trình sẽ tránh không phận và địa hình."

msgid "Route mode"
msgstr "Chế độ hành trình"

msgid "Route climb"
msgstr "Hành trình tăng tốc"

msgid ""
"When enabled and MC is positive, route planning allows climbs between the "
"aircraft location and destination."
msgstr ""
"Khi được kích hoạt và MC là dương, lên kế hoạch hành trình cho phép tăng tốc "
"giữa vị trí máy bay và điểm đến."

msgid "Route ceiling"
msgstr "Tường thành hành trình"

msgid ""
"When enabled, route planning climbs are limited to ceiling defined by "
"greater of current aircraft altitude plus 500 m and the thermal ceiling. If "
"disabled, climbs are unlimited."
msgstr ""
"Khi được kích hoạt, lên kế hoạch hành trình tăng tốc bị giới hạn bởi tường "
"thành lớn hơn của hiện tại máy bay cộng 500 m và tường thành dòng nhiệt. Nếu "
"tắt, tăng tốc không bị giới hạn."

#, no-c-format
msgid "Reach calculations disabled."
msgstr "Các tính toán đến điểm đích đã bị vô hiệu hóa."

#, no-c-format
msgid "Straight"
msgstr "Dài thẳng"

#, no-c-format
msgid "The reach is from straight line paths from the glider."
msgstr "Đường đi là từ đường thẳng giữa tàu lượn."

#, no-c-format
msgid "Turning"
msgstr "Quay vòng"

#, no-c-format
msgid "The reach is calculated allowing turns around terrain obstacles."
msgstr ""
"Đường đi được tính toán cho phép quay vòng xung quanh các vật cản địa hình."

#. Spacer
msgid "Reach mode"
msgstr "Mode đường đi"

msgid ""
"How calculations are performed of the reach of the glider with respect to "
"terrain."
msgstr "Cách thức tính toán đường đi của tàu lượn so với địa hình."

#, no-c-format
msgid "Uses task glide polar."
msgstr "Sử dụng polar lượn của nhiệm vụ."

#, no-c-format
msgid "Safety MC"
msgstr "Mc an toàn"

#, no-c-format
msgid "Uses safety MacCready value."
msgstr "Sử dụng giá trị MacCready an toàn."

msgid "Reach polar"
msgstr "Polar đường đi"

msgid ""
"This determines the glide performance used in reach, landable arrival, abort "
"and alternate calculations."
msgstr ""
"Điều này xác định hiệu suất lượn được sử dụng trong các tính toán đường đi, "
"đến hạ cánh có thể, hủy bỏ và thay thế."

#, no-c-format
msgid "Disables the reach display."
msgstr "Ngừng hiển thị đường đi."

#, no-c-format
msgid "Terrain line"
msgstr "Địa hình"

#, no-c-format
msgid "Draws a dashed line at the terrain glide reach."
msgstr "Vẽ một đường đứt quãng tại đường lượn địa hình của đường đi."

#, no-c-format
msgid "Terrain shade"
msgstr "Độ cao địa hình"

#, no-c-format
msgid "Shades terrain outside glide reach."
msgstr "Tô màu khu vực địa hình ngoài đường lượn đạt được."

#, no-c-format
msgid "Working line"
msgstr "Đường làm việc"

#, no-c-format
msgid "Draws a dashed line at the working glide reach."
msgstr "Vẽ một đường đứt quãng tại đường lượn làm việc."

#, no-c-format
msgid "Working line, terrain line"
msgstr "Đường làm việc, đường địa hình"

#, no-c-format
msgid "Draws a dashed line at the working and terrain glide reaches."
msgstr "Vẽ một đường đứt quãng tại cả đường lượn làm việc và địa hình."

#, no-c-format
msgid "Working line, terrain shade"
msgstr "Đường làm việc, khu vực địa hình"

#, no-c-format
msgid "Draws a dashed line at working, and shade terrain, glide reaches."
msgstr ""
"Vẽ một đường đứt quãng tại đường làm việc và tô màu khu vực địa hình, đường "
"lượn đạt được."

msgid "Reach display"
msgstr "Hiển thị đường đi"

msgid "Arrival height"
msgstr "Chiều cao đến sân bay an toàn"

msgid ""
"The height above terrain that the glider should arrive at for a safe landing."
msgstr "Chiều cao trên địa hình mà tàu lượn nên đến để hạ cánh an toàn."

msgid "Terrain height"
msgstr "Độ cao địa hình"

msgid "The height above terrain that the glider must clear during final glide."
msgstr ""
"Chiều cao trên địa hình mà tàu lượn phải vượt qua trong quá trình lượn cuối."

#, no-c-format
msgid "Simple"
msgstr "Dễ hiểu"

#, no-c-format
msgid "Home"
msgstr "Trang chủ"

msgid "Alternates mode"
msgstr "Mode dự phòng"

msgid ""
"Determines sorting of alternates in the alternates dialog and in abort mode."
msgstr ""
"Xác định cách sắp xếp dự phòng trong hộp thoại dự phòng và chế độ hủy bỏ."

msgid "Polar degradation"
msgstr "Giảm sức mạnh động cơ"

#, no-c-format
msgid ""
"A permanent polar degradation. 0% means no degradation, 50% indicates the "
"glider's sink rate is doubled."
msgstr ""
"Sự suy thoái cực vĩnh viễn. 0% có nghĩa là không bị suy giảm, 50% cho biết "
"tốc độ chìm của tàu lượn tăng gấp đôi."

msgid "Auto bugs"
msgstr "Cờ hiệu tự động"

#, no-c-format
msgid ""
"If enabled, adds 1% to the bugs setting after each full hour while flying."
msgstr "Nếu được bật, sẽ thêm 1% vào cài đặt lỗi sau mỗi giờ bay."

msgid ""
"The MacCready setting used, when safety MC is enabled for reach "
"calculations, in task abort mode and for determining arrival altitude at "
"airfields."
msgstr ""
"Thiết lập MacCready được sử dụng khi an toàn MC được kích hoạt cho tính toán "
"đến điểm trung tâm, trong chế độ hủy bỏ nhiệm vụ và xác định chiều cao đến "
"sân bay."

msgid "STF risk factor"
msgstr "STF yếu tố rủi ro"

msgid ""
"The STF risk factor reduces the MacCready setting used to calculate speed to "
"fly as the glider gets low, in order to compensate for risk. Set to 0.0 for "
"no compensation, 1.0 scales MC linearly with current height (with reference "
"to height of the maximum climb). If considered, 0.3 is recommended."
msgstr ""
"Yếu tố rủi ro STF giảm thiết lập MacCready được sử dụng để tính toán tốc độ "
"bay khi tàu lượn thấp, nhằm bù đắp cho rủi ro. Đặt thành 0.0 không có bù "
"đắp, 1.0 quy mô MC tuyến tính theo chiều cao hiện tại (so với chiều cao của "
"điểm tối đa tăng). Nếu cần thiết, 0.3 được khuyến nghị."

msgid "XCSoar data path"
msgstr "Đường dẫn dữ liệu XCSoar"

msgid "Click to view full path"
msgstr "Nhấp để xem đường dẫn đầy đủ"

msgid "Map database"
msgstr "Cơ sở dữ liệu bản đồ"

msgid "The name of the file (.xcm) containing terrain, topography, and optionally waypoints, their details and airspaces."
msgstr "Tên tệp (.xcm) chứa địa hình, địa vật, và tùy chọn điểm đường bay, chi tiết của chúng và không phận."

msgid "Watched WPTs"
msgstr "Đã xem WPT"

msgid "Waypoint files containing special waypoints for which additional computations like calculation of arrival height in map display always takes place. Useful for waypoints like known reliable thermal sources (e.g. powerplants) or mountain passes."
msgstr "File điểm đường bay chứa các điểm đặc biệt mà tính toán bổ sung như tính chiều cao đến đích trong bản đồ luôn diễn ra. Có ích cho các điểm như nguồn nhiệt ổn định (ví dụ: nhà máy điện) hoặc pass núi."

msgid "WPT A/F details"
msgstr "Chi tiết A/F WPT"

msgid "The files may contain extracts from enroute supplements or other contributed information about individual waypoints and airfields."
msgstr "File có thể chứa trích dẫn từ phụ lục chuyến bay hoặc thông tin đóng góp về các điểm đường bay và sân bay cá nhân."

msgid "FLARM database"
msgstr "Cơ sở dữ liệu FLARM"

msgid "The name of the file containing information about registered FLARM devices."
msgstr "Tên tệp chứa thông tin về các thiết bị FLARM đã đăng ký."

msgid "Regional Atmospheric Soaring Prediction file providing weather forecasts for soaring. Displays color-coded map overlays for thermal strength, boundary layer winds, cloud cover, and other soaring-relevant parameters at various forecast times throughout the day."
msgstr "Tệp dự báo tăng vọt khí quyển khu vực cung cấp dự báo thời tiết cho tăng vọt. Hiển thị lớp phủ bản đồ được mã hóa màu cho cường độ nhiệt, gió lớp ranh giới, độ che phủ của mây và các thông số liên quan đến độ cao tăng vọt khác tại các thời điểm dự báo khác nhau trong ngày."

msgid "The checklist file containing pre-flight and other checklists."
msgstr "Tệp danh sách kiểm tra chứa danh sách kiểm tra trước chuyến bay và các danh sách kiểm tra khác."

#, no-c-format
msgid "Disable display of ground track line."
msgstr "Ngừng hiển thị đường di chuyển mặt đất."

#, no-c-format
msgid "Always display ground track line."
msgstr "Luôn hiển thị đường di chuyển mặt đất."

#, no-c-format
msgid ""
"Display ground track line if there is a significant difference to plane "
"heading."
msgstr ""
"Hiển thị đường di chuyển mặt đất nếu có sự khác biệt đáng kể so với hướng "
"của máy bay."

#, no-c-format
msgid "Vario #1"
msgstr "Đồng hồ tốc độ lên xuống #1"

#, no-c-format
msgid ""
"Within lift areas lines get displayed green and thicker, while sinking lines "
"are shown brown and thin. Zero lift is presented as a grey line."
msgstr ""
"Trong khu vực nâng đỡ, các đường được hiển thị màu xanh lá cây và dày hơn, "
"trong khi các đường giảm dần được thể hiện bằng màu nâu và mỏng. Zero lift "
"được trình bày dưới dạng một đường xám."

#, no-c-format
msgid "Vario #1 (with dots)"
msgstr "Đồng hồ tốc độ lên xuống #1 (có dấu chấm)"

#, no-c-format
msgid ""
"The same colour scheme as the previous, but with dotted lines while sinking."
msgstr "Tương tự như trước đây, nhưng với các đường đứt gãy khi giảm dần."

#, no-c-format
msgid "Vario #2"
msgstr "Đồng hồ tốc độ lên xuống #2"

#, no-c-format
msgid ""
"The climb colour for this scheme is orange to red, sinking is displayed as "
"light blue to dark blue. Zero lift is presented as a yellow line."
msgstr ""
"Màu sắc tăng tốc cho phương án này là màu cam đến đỏ, giảm dần được thể hiện "
"bằng màu xanh dương nhạt đến xanh đậm. Zero lift được trình bày dưới dạng "
"một đường vàng."

#, no-c-format
msgid "Vario #2 (with dots)"
msgstr "Đồng hồ tốc độ lên xuống #2 (có dấu chấm)"

#, no-c-format
msgid "Vario-scaled dots and lines"
msgstr "Đánh dấu và đường đồng hồ tốc độ lên xuống được quy mô hóa"

#, no-c-format
msgid ""
"Vario-scaled dots with lines. Orange to red = climb. Light blue to dark blue "
"= sink. Zero lift is presented as a yellow line."
msgstr ""
"Đốp viario được đánh dấu bằng đường kẻ. Màu cam đến đỏ = tăng tốc. Màu xanh "
"nhạt đến xanh đậm = giảm tốc. Mức độ nâng không là một đường màu vàng."

#, no-c-format
msgid "Vario E-ink"
msgstr "Viario E-ink"

#, no-c-format
msgid ""
"E-ink friendly color scheme, lighter and thicker dots means lift while "
"darker and thinner means sink."
msgstr ""
"Gói màu E-ink thân thiện, các đốp sáng và dày biểu thị mức độ nâng, còn các "
"đốp tối và mỏng biểu thị mức độ giảm tốc."

#, no-c-format
msgid "The colour scheme corresponds to the height."
msgstr "Màu sắc gói theo chiều cao."

#, no-c-format
msgid "Simplified line graphics, black with white contours."
msgstr "Biểu đồ đơn giản, đen với đường viền trắng."

#, no-c-format
msgid "Simple (large)"
msgstr "Đơn giản (toàn màn hình)"

#, no-c-format
msgid "Enlarged simple graphics."
msgstr "Toán hóa đơn giản"

#, no-c-format
msgid "Detailed"
msgstr "Chi tiết"

#, no-c-format
msgid "Detailed rendered aircraft graphics."
msgstr "Chi tiết, biểu đồ máy bay được vẽ chi tiết."

#, no-c-format
msgid "HangGlider"
msgstr "Tàu lượn"

#, no-c-format
msgid "Simplified hang glider as line graphics, white with black contours."
msgstr "Tàu lượn đơn giản được vẽ bằng đường kẻ, màu trắng với đường viền đen."

#, no-c-format
msgid "Simplified para glider as line graphics, white with black contours."
msgstr "Tàu dù đơn giản được vẽ bằng đường kẻ, màu trắng với đường viền đen."

#, no-c-format
msgid "No wind arrow is drawn."
msgstr "Không vẽ mũi tên gió."

#, no-c-format
msgid "Arrow head"
msgstr "Đầu mũi tên"

#, no-c-format
msgid "Draws an arrow head only."
msgstr "Vẽ đầu mũi tên chỉ."

#, no-c-format
msgid "Full arrow"
msgstr "Mũi tên đầy đủ"

#, no-c-format
msgid "Draws an arrow head with a dashed arrow line."
msgstr "Vẽ đầu mũi tên với đường kẻ đứt đoạn."

#, no-c-format
msgid "Symbol"
msgstr "Biểu tượng"

#, no-c-format
msgid "Symbol and Name"
msgstr "Biểu tượng và tên"

msgid "Ground track"
msgstr "Đường di chuyển trên mặt đất"

msgid "Display the ground track as a grey line on the map."
msgstr ""
"Hiển thị đường di chuyển trên mặt đất dưới dạng đường màu xám trên bản đồ."

msgid "This enables the display of FLARM traffic on the map window."
msgstr "Điều này cho phép hiển thị giao thông FLARM trên cửa sổ bản đồ."

msgid "Fade traffic"
msgstr "Giảm độ mờ giao thông"

msgid "Keep showing traffic for a while after it has disappeared."
msgstr ""
"Tiếp tục hiển thị giao thông trong một thời gian sau khi nó đã biến mất."

msgid "Trail length"
msgstr "Độ dài dải dấu hiệu"

msgid ""
"Determines whether and how long a snail trail is drawn behind the glider."
msgstr ""
"Xác định liệu có vẽ dải dấu hiệu phía sau tàu lượn và thời gian vẽ là bao "
"lâu."

msgid "Trail type"
msgstr "Loại dải dấu hiệu"

msgid "Sets the type of the snail trail display."
msgstr "Thiết lập loại hiển thị dải dấu hiệu."

msgid "Trail scaled"
msgstr "Dải dấu hiệu được thay đổi tỷ lệ"

msgid ""
"If set to ON the snail trail width is scaled according to the vario signal."
msgstr ""
"Nếu đặt thành ON, độ rộng của dải dấu hiệu sẽ được điều chỉnh theo tín hiệu "
"variometer."

msgid "Detour cost markers"
msgstr "Biện pháp tránh xa"

msgid ""
"If the aircraft heading deviates from the current waypoint, markers are "
"displayed at points ahead of the aircraft. The value of each marker is the "
"extra distance required to reach that point as a percentage of straight-line "
"distance to the waypoint."
msgstr ""
"Nếu hướng bay của máy bay khác với điểm đường bay hiện tại, biểu đồ được "
"hiển thị ở các điểm phía trước máy bay. Giá trị của mỗi biểu đồ là khoảng "
"cách dư yêu cầu để đến điểm đó, tính theo phần trăm so với khoảng cách thẳng "
"hàng đến điểm đường bay."

msgid "Aircraft symbol"
msgstr "Biểu tượng máy bay"

#, no-c-format
msgid "Wind arrow"
msgstr "Đuôi gió"

msgid "Determines the way the wind arrow is drawn on the map."
msgstr "Xác định cách vẽ mũi tên gió trên bản đồ."

msgid "Start max. speed"
msgstr "Bắt đầu vận tốc tối đa"

msgid "Maximum speed allowed in start observation zone. Set to 0 for no limit."
msgstr ""
"Vận tốc tối đa cho phép trong vùng quan sát khởi động. Đặt thành 0 để vô "
"hiệu hóa giới hạn."

msgid "Start max. speed margin"
msgstr "Khoảng cách vận tốc tối đa khởi động"

msgid ""
"Maximum speed above maximum start speed to tolerate. Set to 0 for no "
"tolerance."
msgstr ""
"Vận tốc tối đa vượt quá vận tốc tối đa khởi động được chấp nhận. Đặt thành 0 "
"để không có sự dung sai."

msgid "Start max. height"
msgstr "Chiều cao tối đa khởi động"

msgid ""
"Maximum height based on start height reference (AGL or MSL) while starting "
"the task. Set to 0 for no limit."
msgstr ""
"Chiều cao tối đa dựa trên tham chiếu chiều cao khởi động (AGL hoặc MSL) khi "
"bắt đầu nhiệm vụ. Đặt thành 0 để vô hiệu hóa giới hạn."

msgid "Start max. height margin"
msgstr "Khoảng cách chiều cao tối đa khởi động"

msgid ""
"Maximum height above maximum start height to tolerate. Set to 0 for no "
"tolerance."
msgstr ""
"Chiều cao vượt quá chiều cao tối đa khởi động được chấp nhận. Đặt thành 0 để "
"không có sự dung sai."

#, no-c-format
msgid "Reference is the height above the task point."
msgstr "Tham chiếu là chiều cao trên điểm nhiệm vụ."

#, no-c-format
msgid "Reference is altitude above mean sea level."
msgstr "Tham chiếu là độ cao trên mực nước biển trung bình."

msgid "Start height ref."
msgstr "Chiều cao tham chiếu khởi động"

msgid "Reference used for start max height rule."
msgstr "Tham chiếu được sử dụng cho quy tắc chiều cao tối đa khởi động."

msgid "Finish min. height"
msgstr "Chiều cao tối thiểu hoàn thành"

msgid ""
"Minimum height based on finish height reference (AGL or MSL) while finishing "
"the task. Set to 0 for no limit."
msgstr ""
"Chiều cao tối thiểu dựa trên tham chiếu chiều cao hoàn thành (AGL hoặc MSL) "
"khi hoàn thành nhiệm vụ. Đặt thành 0 để vô hiệu hóa giới hạn."

msgid "Finish height ref."
msgstr "Tham chiếu chiều cao hoàn thành"

msgid "Reference used for finish min height rule."
msgstr "Tham chiếu được sử dụng cho quy tắc chiều cao tối thiểu hoàn thành."

msgid "PEV start wait time"
msgstr "Thời gian ước lượng cho bài thi"

msgid ""
"Wait time in minutes after Pilot Event and before start gate opens. 0 means "
"start opens immediately."
msgstr ""
"Thời gian chờ trong phút sau sự kiện phi công và trước khi cửa khởi động mở. "
"Đặt thành 0 để cửa khởi động mở ngay lập tức."

msgid "PEV start window"
msgstr "Khung thời gian bắt đầu PEV"

msgid ""
"Number of minutes start remains open after Pilot Event and PEV wait time.0 "
"means start will never close after it opens."
msgstr ""
"Số phút mà cửa bắt đầu vẫn mở sau sự kiện phi công và thời gian chờ PEV. Đặt "
"thành 0 để cửa bắt đầu sẽ không bao giờ đóng sau khi mở."

#, no-c-format
msgid "Gate width"
msgstr "Chiều rộng cổng"

#, no-c-format
msgid "Radius"
msgstr "Bán kính"

msgid "Default start type for new tasks you create."
msgstr "Loại bắt đầu mặc định cho các nhiệm vụ mới bạn tạo."

msgid "Default radius or gate width of the start zone for new tasks."
msgstr ""
"Bán kính hoặc chiều rộng cổng mặc định của vùng bắt đầu cho các nhiệm vụ mới."

msgid "Finish point"
msgstr "Điểm kết thúc"

msgid "Default finish type for new tasks you create."
msgstr "Loại kết thúc mặc định cho các nhiệm vụ mới bạn tạo."

msgid "Default radius or gate width of the finish zone in new tasks."
msgstr ""
"Bán kính hoặc chiều rộng cổng mặc định của vùng kết thúc trong các nhiệm vụ "
"mới."

msgid "Turn point"
msgstr "Điểm quay vòng"

msgid "Default turn point type for new tasks you create."
msgstr "Loại điểm quay vòng mặc định cho các nhiệm vụ mới bạn tạo."

msgid "Default radius of turnpoint cylinders and sectors in new tasks."
msgstr ""
"Bán kính mặc định của hình cầu và sector tại điểm quay vòng trong các nhiệm "
"vụ mới."

msgid "Default task type for new tasks you create."
msgstr "Loại nhiệm vụ mặc định cho các nhiệm vụ mới bạn tạo."

msgid "AAT min. time"
msgstr "Thời gian AAT tối thiểu"

msgid "Default AAT min. time for new AAT tasks."
msgstr "Thời gian AAT tối thiểu mặc định cho các nhiệm vụ AAT mới."

msgid "Optimisation margin"
msgstr "Khoảng cách tối ưu hoá"

msgid ""
"Safety margin for AAT task optimisation. Optimisation seeks to complete the "
"task at the minimum time plus this margin time."
msgstr ""
"Khoảng cách an toàn cho tối ưu hoá nhiệm vụ AAT. Tối ưu hoá cố gắng hoàn "
"thành nhiệm vụ trong thời gian ít nhất cộng với khoảng cách này."

#, no-c-format
msgid "Disable contest calculations"
msgstr "Khóa tính toán giải đấu"

#, no-c-format
msgid "Conforms to FAI triangle rules. Three turns and common start and finish. No leg less than 28% of total except for tasks longer than 500km: No leg less than 25% or larger than 45%."
msgstr "Phù hợp với quy tắc tam giác FAI. Ba lượt và bắt đầu và kết thúc chung. Không có chặng nào nhỏ hơn 28% tổng số ngoại trừ các nhiệm vụ dài hơn 500km: Không có chặng nào nhỏ hơn 25% hoặc lớn hơn 45%."

#, no-c-format
msgid "Up to seven points including start and finish, finish height must not be lower than start height less 1000 meters."
msgstr "Tối đa bảy điểm bao gồm điểm bắt đầu và kết thúc, độ cao điểm kết thúc không được thấp hơn độ cao điểm bắt đầu ít nhất 1000 mét."

#, no-c-format
msgid "The most recent contest with Sprint task rules."
msgstr "Giải đấu gần đây nhất với quy tắc nhiệm vụ Sprint."

#, no-c-format
msgid "A combination of Classic and FAI rules. 30% of the FAI score are added to the Classic score."
msgstr "Sự kết hợp giữa quy tắc Cổ điển và FAI. 30% điểm FAI được cộng vào điểm Cổ điển."

#, no-c-format
msgid "PG online contest with different track values: Free flight - 1 km = 1.0 point; flat triangle - 1 km = 1.2 p; FAI triangle - 1 km = 1.4 p."
msgstr "Cuộc thi PG trực tuyến với giá trị đường đua khác nhau: Bay tự do - 1 km = 1 điểm; Tam giác phẳng - 1 km = 1,2 điểm; Tam giác FAI - 1 km = 1,4 điểm."

#, no-c-format
msgid "European PG online contest of the DHV organization. Pretty much the same as the XContest rules, but with different track values: 1 km = 1.5 points, 1.75 p and 2.0 p for FAI triangles respectively."
msgstr "Cuộc thi PG trực tuyến của tổ chức DHV ở châu Âu. Rất tương tự với quy tắc XContest, nhưng với các giá trị đường đua khác: 1 km = 1,5 điểm, 1,75 điểm và 2 điểm cho tam giác FAI."

#, no-c-format
msgid "Austrian online glider contest. Tracks around max. six waypoints are scored. The bounding box part with 1 km = 1.0 point and the additional zick-zack part with 1 km = 0.5 p."
msgstr "Cuộc thi bay lượn trực tuyến của Áo. Các điểm được ghi chép quanh tối đa sáu điểm đường bay. Phần hộp giới hạn với 1 km = 1 điểm và phần zig-zag bổ sung với 1 km = 0,5 điểm."

#, no-c-format
msgid "WeGlide combines multiple scoring systems in the WeGlide Free contest. The free score is a combination of the free distance score and the area bonus. For the area bonus, the scoring program determines the largest FAI triangle and the largest Out & Return distance that can be fitted into the flight route."
msgstr "WeGlide kết hợp nhiều hệ thống đánh giá trong cuộc thi WeGlide Free. Điểm tự do là sự kết hợp giữa điểm từ quãng đường bay tự do và lợi thế khu vực. Đối với lợi thế khu vực, chương trình đánh giá xác định tam giác FAI lớn nhất và khoảng cách Out & Return lớn nhất có thể phù hợp vào hành trình bay."

#, no-c-format
msgid "A start point, one turn point and a finish point are chosen from the flight path such that the distance between the start point and the turn point is maximized."
msgstr "Một điểm bắt đầu, một điểm quay vòng và một điểm kết thúc được chọn từ đường bay sao cho khoảng cách giữa điểm bắt đầu và điểm quay vòng được tối đa hóa."

#, no-c-format
msgid "LVZC Charron.online, 5 legs under 200km 6 legs above. Minimum leg distance is 20km, 5 points per km."
msgstr "LVZC Charron.online, 5 đoạn dưới 200km, 6 đoạn trên 200km. Khoảng cách đoạn tối thiểu là 20km, 5 điểm/km."

msgid "Contest"
msgstr "Màu sắc"

msgid "Select the rules used for calculating optimal points for a contest."
msgstr "Chọn quy tắc được sử dụng để tính toán số điểm tối ưu cho cuộc thi."

msgid "Predict Contest"
msgstr "Dự đoán Cuộc thi"

msgid "If enabled, then the next task point is included in the score calculation, assuming that you will reach it."
msgstr "Nếu kích hoạt, thì điểm tiếp theo trong đường đua sẽ được bao gồm vào quá trình tính điểm, giả định rằng bạn sẽ đến được nó."

msgid "FAI triangle areas"
msgstr "Diện tích tam giác FAI"

msgid "Show FAI triangle areas on the map."
msgstr "Hiển thị diện tích tam giác FAI trên bản đồ."

msgid "FAI triangle threshold"
msgstr "Ngưỡng tam giác FAI"

msgid "Specifies which threshold is used for \"large\" FAI triangles."
msgstr "Chỉ định ngưỡng nào được sử dụng cho \"tam giác lớn\" FAI."

#, no-c-format
msgid "95% dist. rule helpers"
msgstr "95% dist. rule trợ lý"

msgid "Show helpers for Argentinean Federation \"95% distance\" rule. The AAT Distance Around Target InfoBox will show projected distance vs. maximum and change colors as you approach 95%."
msgstr "Hiển thị những người trợ giúp cho quy tắc \"95% khoảng cách\" của Liên bang Argentina. Khoảng cách AAT xung quanh Hộp thông tin mục tiêu sẽ hiển thị khoảng cách dự kiến ​​so với mức tối đa và thay đổi màu sắc khi bạn đạt tới 95%."

msgid "Draw a digital elevation terrain on the map."
msgstr "Vẽ địa hình số hóa lên bản đồ."

msgid "Topography display"
msgstr "Hiển thị địa hình"

msgid "Draw topographical features (roads, rivers, lakes etc.) on the map."
msgstr "Vẽ các đặc điểm địa hình (đường, sông, hồ v.v.) lên bản đồ."

