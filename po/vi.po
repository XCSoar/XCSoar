msgstr "Tần số âm thanh được phát ra khi đạt tốc độ lún tối đa."

msgid "Zero Frequency"
msgstr "Tần số cực tiểu"

msgid "The tone frequency that is played at zero climb rate."
msgstr "Tần số âm thanh được phát ra khi không có độ nâng."

msgid "Max. Frequency"
msgstr "Tần số cực đại"

msgid "The tone frequency that is played at maximum climb rate."
msgstr "Tần số âm thanh được phát ra khi đạt tốc độ lên tối đa."

msgid "Deadband min. lift"
msgstr "Giới hạn độ nâng thấp"

msgid ""
"Below this lift threshold the vario will start to play sounds if the "
"'Deadband' feature is enabled."
msgstr ""
"Dưới ngưỡng độ nâng này, đồng hồ tốc độ lên xuống sẽ bắt đầu phát âm thanh "
"nếu tính năng 'Deadband' được kích hoạt."

msgid "Deadband max. lift"
msgstr "Giới hạn độ nâng cao"

msgid ""
"Above this lift threshold the vario will start to play sounds if the "
"'Deadband' feature is enabled."
msgstr ""
"Trên ngưỡng độ nâng này, đồng hồ tốc độ lên xuống sẽ bắt đầu phát âm thanh "
"nếu tính năng 'Deadband' được kích hoạt."

msgid "Master Volume"
msgstr "Âm lượng"

msgid "The overall audio output volume."
msgstr "Âm lượng đầu ra âm thanh tổng thể."

msgid "Airport ICAO code"
msgstr "Mã ICAO của sân bay"

msgid "Please enter the FOUR letter code of the desired station."
msgstr "Vui lòng nhập mã bốn chữ cái của trạm mong muốn."

#, c-format
msgid "Do you want to remove station %s?"
msgstr "Bạn có muốn xóa trạm %s không?"

msgid "This function is not available on your platform yet."
msgstr "Hàm này chưa sẵn dùng trên nền tảng của bạn."

msgid "Maximum start speed exceeded"
msgstr "Tốc độ khởi động tối đa đã vượt quá"

msgid "In sector, arm advance when ready"
msgstr "Trong sector, kích hoạt khi sẵn sàng"

msgid "Arm"
msgstr "Kích hoạt"

msgid "Dismiss"
msgstr "Trừ bỏ"

msgid "Add this turn point?"
msgstr "Điểm rẽ tiếp theo"

msgid "Use"
msgstr "Sử dụng"

msgid "No METAR available"
msgstr "Không có METAR sẵn"

msgid "Dew Point"
msgstr "Điểm sương"

msgid "Visibility"
msgstr "Quan sát thấy"

