msgctxt "Button"
msgid "Preload Selected"
msgstr "Tải trước đã chọn"

msgid "Select SkySight Layers"
msgstr "Chọn lớp SkySight"

#, no-c-format
msgctxt "Button"
msgid "Select all"
msgstr "Chọn tất cả"

#, no-c-format
msgctxt "Button"
msgid "Select none"
msgstr "Bỏ chọn"

msgid "Some selected layers couldn't be added (the list may be full)."
msgstr "Không thể thêm một số lớp đã chọn (danh sách có thể đã đầy)."

msgid "Couldn't preload forecast data."
msgstr "Không thể tải trước dữ liệu dự báo."

msgid "Couldn't apply the selected SkySight layer to the current page."
msgstr "Không thể áp dụng lớp SkySight đã chọn cho trang hiện tại."

#, c-format
msgid "Cache %u forecast files for %u selected SkySight layers for offline use?"
msgstr ""
"Lưu bộ nhớ đệm %u tệp dự báo cho %u lớp SkySight đã chọn để dùng ngoại "
"tuyến?"

#, c-format
msgid "Discover and cache all forecasts for %u selected SkySight layers for offline use?"
msgstr ""
"Tìm và lưu bộ nhớ đệm mọi dự báo cho %u lớp SkySight đã chọn để dùng ngoại "
"tuyến?"

msgid "SkySight offline cache"
msgstr "Bộ nhớ đệm ngoại tuyến SkySight"

#, c-format
msgid "%s in %u files"
msgstr "%s trong %u tệp"

#, c-format
msgid "Delete %s of cached SkySight data? This includes any recently downloaded forecasts and map tiles. The active layer may be downloaded again if Auto update is enabled."
msgstr ""
"Xóa %s dữ liệu SkySight đã lưu đệm? Bao gồm các dự báo và ô bản đồ vừa tải. "
"Lớp đang hoạt động có thể được tải lại nếu bật tự động cập nhật."

msgid "Clear SkySight cache"
msgstr "Xóa bộ nhớ đệm SkySight"

#, c-format
msgid "Deleted %s in %u files."
msgstr "Đã xóa %s trong %u tệp."

msgid "Automatically download missing or newer SkySight data for the current map page. Manual preload remains available."
msgstr ""
"Tự động tải dữ liệu SkySight thiếu hoặc mới hơn cho trang bản đồ hiện tại. "
"Vẫn có thể tải trước thủ công."

#, no-c-format
msgctxt "Setting"
msgid "Cache"
msgstr "Bộ nhớ đệm"

msgid "Total disk space used by the SkySight cache folder."
msgstr "Tổng dung lượng đĩa dùng bởi thư mục bộ nhớ đệm SkySight."

#, no-c-format
msgctxt "Button"
msgid "Clear downloaded data"
msgstr "Xóa dữ liệu đã tải"

msgid "SkySight is unavailable."
msgstr "SkySight không khả dụng."

#, c-format
msgid "SkySight rate limit reached; continuing in %u seconds."
msgstr "Đã đạt giới hạn tốc độ SkySight; tiếp tục sau %u giây."

msgid "SkySight downloads resumed."
msgstr "Đã tiếp tục tải SkySight."

msgid "Loading SkySight forecast steps..."
msgstr "Đang tải các bước dự báo SkySight…"

#, c-format
msgid "SkySight forecasts: %u of %u available..."
msgstr "Dự báo SkySight: %u / %u khả dụng…"

#, c-format
msgid "SkySight rate limited; continuing in %u seconds..."
msgstr "SkySight bị giới hạn tốc độ; tiếp tục sau %u giây…"

#, c-format
msgid "SkySight connection failed; retrying in %u seconds..."
msgstr "Kết nối SkySight thất bại; thử lại sau %u giây…"

#, c-format
msgid "SkySight preload completed with %u failures."
msgstr "Tải trước SkySight hoàn tất với %u lỗi."

#, c-format
msgid "SkySight offline cache ready: %u files."
msgstr "Bộ nhớ đệm ngoại tuyến SkySight sẵn sàng: %u tệp."

#, c-format
msgid "SkySight cache finished: %u of %u files ready, %u failed."
msgstr "Bộ nhớ đệm SkySight xong: %u / %u tệp sẵn sàng, %u lỗi."

