msgstr "Núi thấp"

msgid "Terrain colors"
msgstr "Màu sắc địa hình"

msgid "Defines the color ramp used in terrain rendering."
msgstr "Định nghĩa dải màu được sử dụng trong việc vẽ địa hình."

#, no-c-format
msgid "Sun"
msgstr "Mặt trời"

msgid "Slope shading"
msgstr "Tô đồi"

msgid "Terrain contrast"
msgstr "Độ tương phản của địa hình"

msgid "Defines the amount of Phong shading in the terrain rendering. Use large values to emphasise terrain slope, smaller values if flying in steep mountains."
msgstr "Định nghĩa lượng phong tỏa trong việc vẽ địa hình. Sử dụng giá trị lớn để nhấn mạnh độ dốc của địa hình, sử dụng giá trị nhỏ hơn nếu bay qua những ngọn núi dốc."

msgid "Terrain brightness"
msgstr "Độ sáng địa hình"

msgid "Defines the brightness (whiteness) of the terrain rendering. This controls the average illumination of the terrain."
msgstr "Định nghĩa độ sáng (trắng) của việc vẽ địa hình. Điều này kiểm soát ánh sáng trung bình trên địa hình."

msgid "Contours"
msgstr "Đường đồng mức"

msgid "Preset"
msgstr "Cài đặt"

msgid "Load a set of units."
msgstr "Load một tập đơn vị."

msgid "Custom"
msgstr "Tùy chỉnh"

msgid "My individual set of units."
msgstr "Bộ đơn vị cá nhân của tôi."

#, no-c-format
msgid "knots"
msgstr "hải lý/phút"

msgid "Aircraft/Wind speed"
msgstr "Phương tiện bay/tốc độ gió"

msgid ""
"Units used for airspeed and ground speed. A separate unit is available for "
"task speeds."
msgstr ""
"Đơn vị được sử dụng cho tốc độ không khí và tốc độ mặt đất. Một đơn vị riêng "
"biệt có sẵn cho tốc độ nhiệm vụ."

msgid ""
"Units used for horizontal distances e.g. range to waypoint, distance to go."
msgstr ""
"Đơn vị được sử dụng cho khoảng cách ngang, ví dụ: quãng đường đến điểm đường "
"bay, còn lại để đi."

msgid "Lift"
msgstr "Nâng"

msgid "Units used for vertical speeds (variometer)."
msgstr "Đơn vị được sử dụng cho tốc độ dọc (đồng hồ variometer)."

#, no-c-format
msgid "feet"
msgstr "feet mét"

#, no-c-format
msgid "meters"
msgstr "mét"

msgid "Units used for altitude and heights."
msgstr "Đơn vị được sử dụng cho độ cao và chiều cao."

msgid "Units used for temperature."
msgstr "Đơn vị được sử dụng cho nhiệt độ."

msgid "Units used for task speeds."
msgstr "Đơn vị được sử dụng cho tốc độ nhiệm vụ."

msgid "Units used for pressures."
msgstr "Đơn vị được sử dụng cho áp suất."

msgid "Units used for mass."
msgstr "Đơn vị được sử dụng cho khối lượng."

msgid "Units used for wing loading."
msgstr "Đơn vị được sử dụng cho tải cánh."

msgid "Lat./Lon."
msgstr "Vĩ/Kinh"

msgid "Units used for latitude and longitude."
msgstr "Đơn vị được sử dụng cho vĩ độ và kinh độ."

msgid "Rotation"
msgstr "Thông tin"

msgid "Unit used for rotation."
msgstr "Đơn vị được sử dụng cho quay."

#, no-c-format
msgid "UTC offset"
msgstr "Độ lệch múi giờ UTC"

msgid ""
"The UTC offset field allows the UTC local time offset to be specified. The "
"local time is displayed below in order to make it easier to verify the "
"correct offset has been entered."
msgstr ""
"Trường-offset giờ UTC cho phép chỉ định múi giờ địa phương của thời gian "
"UTC. Thời gian địa phương được hiển thị dưới dạng để dễ dàng xác nhận múi "
"giờ đã nhập chính xác."

msgid "Use GPS time"
msgstr "Sử dụng thời gian từ GPS"

msgid ""
"If enabled sets the clock of the computer to the GPS time once a fix is set. "
"This is only necessary if your computer does not have a real-time clock with "
"battery backup or your computer frequently runs out of battery power or "
"otherwise loses time."
msgstr ""
"Nếu kích hoạt, thiết lập đồng hồ máy tính thành thời gian GPS một khi có "
"fix. Điều này chỉ cần thiết nếu máy tính của bạn không có đồng hồ thời gian "
"thực với pin dự phòng hoặc máy tính của bạn thường xuyên hết pin hoặc mất "
"thời gian khác."

#, no-c-format
msgid "Full name"
msgstr "Tên đầy đủ"

#, no-c-format
msgid "The full name of each waypoint is displayed."
msgstr "Tên đầy đủ của mỗi điểm đường bay được hiển thị."

#, no-c-format
msgid "First word of name"
msgstr "Từ đầu tên"

#, no-c-format
msgid "The first word of the waypoint name is displayed."
msgstr "Từ đầu của tên điểm đường bay được hiển thị."

#, no-c-format
msgid "First 3 letters"
msgstr "Ba ký tự đầu"

#, no-c-format
msgid "The first 3 letters of the waypoint name are displayed."
msgstr "Ba ký tự đầu tiên của tên điểm đường bay được hiển thị."

#, no-c-format
msgid "First 5 letters"
msgstr "Năm ký tự đầu"

#, no-c-format
msgid "The first 5 letters of the waypoint name are displayed."
msgstr "Năm ký tự đầu tiên của tên điểm đường bay được hiển thị."

#, no-c-format
msgid "No waypoint name is displayed."
msgstr "Không hiển thị tên điểm đường bay."

#, no-c-format
msgid "The short name of each waypoint is displayed. If unavailable, the first five letters of the full name are displayed."
msgstr "Tên ngắn của mỗi điểm đường bay được hiển thị. Nếu không có, ba ký tự đầu tiên của tên đầy đủ được hiển thị."

msgid "Label format"
msgstr "Định dạng nhãn"

msgid "Determines how labels are displayed with each waypoint"
msgstr "Xác định cách hiển thị nhãn với mỗi điểm đường bay"

#, no-c-format
msgid "No arrival height is displayed."
msgstr "Không hiển thị độ cao đến sân."

#, no-c-format
msgid "Straight glide"
msgstr "Lượn thẳng"

#, no-c-format
msgid "Straight glide arrival height (no terrain is considered)."
msgstr "Độ cao đến sân lượn thẳng (không xem xét địa hình)."

#, no-c-format
msgid "Terrain avoidance glide"
msgstr "Lượn tránh địa hình"

#, no-c-format
msgid "Arrival height considering terrain avoidance. Requires \"Reach mode: Turning\" in \"Glide Computer > Route\" settings."
msgstr "Độ cao đến sân xem xét tránh địa hình. Yêu cầu \"Chế độ đến: Quay vòng\" trong cài đặt \"Computer > Đường bay\"."

#, no-c-format
msgid "Straight & terrain glide"
msgstr "Lượn thẳng & tránh địa hình"

#, no-c-format
msgid "Both arrival heights are displayed. Requires \"Reach mode: Turning\" in \"Glide Computer > Route\" settings."
msgstr "Cả hai độ cao đến sân đều được hiển thị. Yêu cầu \"Chế độ đến: Quay vòng\" trong cài đặt \"Computer > Đường bay\"."

#, no-c-format
msgid "Required GR & terrain glide"
msgstr "Tỷ lệ lượn cần thiết & tránh địa hình"

#, no-c-format
msgid "Both Required glide ratio and terrain avoidance height are displayed. Requires \"Reach mode: Turning\" in \"Glide Computer > Route\" settings."
msgstr "Cả tỷ lệ lượn cần thiết và độ cao tránh địa hình đều được hiển thị. Yêu cầu \"Chế độ đến: Quay vòng\" trong cài đặt \"Computer > Đường bay\"."

msgid "Determines how arrival height is displayed in waypoint labels"
msgstr "Xác định cách độ cao đến đích được hiển thị trong nhãn điểm đường bay"

#, no-c-format
msgid "Rounded rectangle"
msgstr "Hình chữ nhật bo tròn"

#, no-c-format
msgid "Outlined"
msgstr "Bordered"

msgid "Label style"
msgstr "Kiểu nhãn"

#, no-c-format
msgid "Task waypoints & airfields"
msgstr "Điểm nhiệm vụ & sân bay"

#, no-c-format
msgid "All waypoints part of a task and all airfields will be displayed."
msgstr "Tất cả các điểm đường bay thuộc nhiệm vụ và tất cả các sân bay sẽ được hiển thị."

#, no-c-format
msgid "Task waypoints & landables"
msgstr "Điểm nhiệm vụ & hạ cánh"

#, no-c-format
msgid "All waypoints part of a task and all landables will be displayed."
msgstr "Tất cả các điểm đường bay thuộc nhiệm vụ và tất cả các điểm hạ cánh sẽ được hiển thị."

#, no-c-format
msgid "Task waypoints"
