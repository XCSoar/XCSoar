msgstr "Trợ giúp cử chỉ"

msgid "Emulate the sound of an electronic vario."
msgstr "Giả lập âm thanh của đồng hồ tốc độ lên xuống điện tử."

msgid "The audio vario sound volume."
msgstr "Âm lượng âm thanh đa dạng."

msgid "Enable Deadband"
msgstr "Kích hoạt deadband"

