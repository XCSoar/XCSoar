"Mute the audio output in when the current lift is in a certain range around "
"zero"
msgstr ""
"Ngắt âm thanh khi độ nâng hiện tại trong một phạm vi nhất định xung quanh số "
"0"

msgid "Min. Frequency"
msgstr "Tần số cực tiểu"

