msgid "8 Top or Left"
msgstr "8 zgornje ali leve"

#, no-c-format
msgid "8 Top + Vario (Portrait)"
msgstr "8 zgornje + variometer (priklicno)"

#, no-c-format
msgid "9 Right + Vario (Landscape)"
msgstr "9 desno + variometer (vzhodnična)"

#, no-c-format
msgid "9 Left + Right + Vario (Landscape)"
msgstr "9 levo + desno + variometer (vzhodnična)"

#, no-c-format
