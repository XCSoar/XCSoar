msgid ""
"For auto and all below airspace mode, this is the altitude above/below which "
"airspace is included."
msgstr ""
"V načinu s avtomatskim in vseh spodnjih zračnih prostorov je ta višina "
"zgornja ali spodnja granica, ki je vključena."

msgid "Enable/disable all airspace warnings."
msgstr "Upravljaj vse opozarjanje o zračnem prostoru"

msgid "Warnings dialog"
msgstr "Okno opozarjanj"

msgid "Enable/disable displaying airspaces warnings dialog."
msgstr "Upravljaj prikaz okna opozarjanj o zračnem prostoru."

msgid "Warning time"
msgstr "Čas opozarjanja"

msgid ""
"This is the time before an airspace incursion is estimated at which the "
"system will warn the pilot."
msgstr ""
"Ta čas je razdalja pred ocenjenim vtrtanjem v zračni prostor, ko ga sistema "
"opozori."

msgid "Repetitive sound"
msgstr "Ponavljajoče se zvok"

msgid ""
"Enable/disable repetitive warning sound when airspaces warnings dialog is "
"displayed."
msgstr ""
"Upravljaj ponavljajoči se zvok opozarjanj, ko je prikazano okno o zračnem "
"prostoru."

msgid "Acknowledge time"
msgstr "Čas potrditve"

msgid ""
"This is the time period in which an acknowledged airspace warning will not "
"be repeated."
msgstr ""
"Ta čas je razpon, v katerem bo opozarjenje o zračnem prostoru, ki ga je "
"uporabnik potrdoval, znova ponavljeno."

msgid "Use black outline"
msgstr "Uporabi crveno okvir"

msgid ""
"Draw a black outline around each airspace rather than the airspace color."
msgstr ""
"Nariši crven okvir okoli vsakega zračnega prostora, namreč ne bo prikazana "
"barva zračnega prostora."

msgid "Airspace fill mode"
msgstr "Način napolnjanja zračnega prostora"

msgid "Specifies the mode for filling the airspace area."
msgstr "Ustrezni način napolnjanja oblasti zračnega prostora."

msgid "Airspace transparency"
msgstr "Prohodnost zračnega prostora"

msgid "If enabled, then airspaces are filled transparently."
msgstr "Če je omogočeno, se zračni prostori natančno napolnijo."

#, no-c-format
msgid "Disable final glide bar."
msgstr "Onemogoči končni drs baro."

#, no-c-format
msgid "Always show final glide bar."
msgstr "Vžgajaj končni drs baro v vseh primerih."

#, no-c-format
msgid "Show final glide bar if approaching final glide range."
msgstr "Prikaži končni drs baro, če se približujete do območja za končni drs."

#, no-c-format
msgid "Auto (follow InfoBoxes)"
msgstr "Samodejno (po sleditvi InfoBox-ov)"

#, no-c-format
msgid "Top left"
msgstr "V zgornjem levem kotu"

#, no-c-format
msgid "Top right"
msgstr "V zgornjem desnem kotu"

#, no-c-format
