msgid "Shaded"
msgstr "Skjulte"

#, no-c-format
msgid "Glass"
msgstr "Glas"

#, no-c-format
msgid "Use the system-wide setting"
msgstr "Brug systemets indstillinger"

#, no-c-format
msgid "Black text on white background"
msgstr "Sort tekst på hvid baggrund"

#, no-c-format
msgid "White text on black background"
msgstr "Hvid tekst på sort baggrund"

#, no-c-format
msgid "Follow global"
msgstr "Følg globalt"

#, no-c-format
msgid "Use the same light/dark mode as the overall UI."
msgstr ""
"Brug den samme lys/mørke tilstand som den overordnede brugergrænseflade."

#, no-c-format
msgid "Light"
msgstr "Lys"

#, no-c-format
msgid "Always use dark text on a light InfoBox background."
msgstr "Brug altid mørk tekst på en lys InfoBox-baggrund."

#, no-c-format
msgid "Dark"
msgstr "Mørk"

#, no-c-format
msgid "Always use light text on a dark InfoBox background."
msgstr "Brug altid lys tekst på en mørk InfoBox-baggrund."

msgid "Full screen"
msgstr "Fullskærm"

msgid "Run XCSoar in full screen mode"
msgstr "Kør XCSoar i fullskærmstilstand"

msgid "Display orientation"
msgstr "Visningsorientering"

msgid "Rotate the display on devices that support it."
msgstr "Venden visningen på enheder, der understøtter det."

msgid "Dark mode"
msgstr "Mørk modus"

msgid "InfoBox geometry"
msgstr "InfoBox-geometri"

msgid ""
"A list of possible InfoBox layouts. Do some trials to find the best for your "
"screen size."
msgstr ""
"En liste over mulige InfoBox-udstillinger. Gør nogle prøver for at finde den "
"bedste til din skærmsstørrelse."

msgid "InfoBox title size"
msgstr "InfoBox-titelstørrelse"

msgid "Zoom factor for InfoBox title and comment text"
msgstr "Zoomfaktor for InfoBox-titelt tekst og kommentar tekst"

msgid "Tab dialog style"
msgstr "Tagdialogstil"

msgid "Message display"
msgstr "Meddelelsevisning"

msgid "Colored InfoBoxes"
msgstr "Farverne InfoBoxes"

msgid ""
"If true, certain InfoBoxes will have coloured text. For example, the active "
"waypoint InfoBox will be blue when the glider is above final glide."
msgstr ""
"Hvis sand, vil nogle InfoBoxes have farvede tekster. For eksempel vil aktive "
"waypoint InfoBox være blå, når svæveflytet er over slutglid."

msgid "InfoBox theme"
msgstr "Infoboks tema"

msgid "InfoBox border"
msgstr "Randfarve InfoBox"

msgid "Show Menu button"
msgstr "Vis Menu knap"

msgid "Show the Menu button"
msgstr "Vis Menu knappen"

msgid "Show Zoom button"
msgstr "Vis Zoom knap"

msgid "Show the Zoom button"
msgstr "Vis Zoom knappen"

msgid "Cursor zoom"
msgstr "Kurzumforsøg"

msgid "Cursor zoom factor"
msgstr "Kurzumforsøgsfaktor"

msgid "Invert cursor color"
msgstr "Invertere cursorfarve"

msgid "Enable black cursor"
msgstr "Aktivér svart cursor"

#, no-c-format
msgid "Start only"
msgstr "Start kun"

msgid "Pilot name"
msgstr "Pilotens navn"

msgid "Name of the pilot in command, recorded in the IGC flight log."
msgstr "Navn på kommandopiloten, registreret i IGC's flyvelog."

msgid "CoPilot name"
msgstr "Copilots navn"

msgid "The co-pilot name recorded in the IGC flight log."
msgstr "Co-pilotens navn registreret i IGC's flyvelog."

msgid "Crew weight default"
msgstr "Besætningsvægt standard"

msgid ""
"Default for all weight loaded to the glider beyond the empty weight and "
"besides the water ballast."
msgstr ""
"Standard for alle vægt, der ladres til svæveflytet over legetætheden og uden "
"for vandballast."

msgid "Time step cruise"
msgstr "Tidsinterval flyvemodus"

msgid "This is the time interval between logged points when not circling."
msgstr "Dette er tidsintervallet mellem loggede punkter, når ikke kringløb."

msgid "Time step circling"
msgstr "Tidsinterval kringløb"

msgid "This is the time interval between logged points when circling."
msgstr "Dette er tidsintervallet mellem loggede punkter, når kringløb."

msgid "Auto. logger"
msgstr "Automatisk logger"

msgid ""
"Enables the automatic starting and stopping of logger on takeoff and landing "
"respectively. Disable when flying paragliders."
msgstr ""
"Aktiverer automatisk start og stop af logger ved start og landning "
"respektive. Deaktiver when flying paragliders."

msgid ""
"Enable the NMEA logger on startup? If this option is disabled, the NMEA "
"logger can still be started manually."
msgstr ""
"Skal NMEA logger aktiveres ved opstart? Hvis denne indstilling er "
"deaktiveret, kan NMEA logger stadig blive startet manuelt."

msgid "Log book"
msgstr "Log bog"

msgid "Logs each start and landing."
msgstr "Logger hver start og landning."

msgid "Logger ID"
msgstr "Logger-ID"

msgid "The three-letter logger ID used in the IGC filename."
msgstr "Logger-id'et på tre bogstaver, der bruges i IGC-filnavnet."

#, no-c-format
msgid ""
"The moving map display will be rotated so the glider's track is oriented up."
msgstr "Flytter kortværktøjet så glidernes rute orienteres op."

#, no-c-format
msgid "Heading up"
msgstr "Kurs op"

#, no-c-format
msgid ""
"The moving map display will be rotated so the glider's heading is oriented "
"up."
msgstr "Flytter kortværktøjet så glidernes kurs orienteres op."

#, no-c-format
msgid ""
"The moving map display will always be orientated north to south and the "
"glider icon will be rotated to show its course."
msgstr ""
"Flytter kortværktøjet altid nord-syd og roterer gliderikonet for at vise "
"dens kurs."

#, no-c-format
msgid "Target up"
msgstr "Mål op"

#, no-c-format
msgid ""
"The moving map display will be rotated so the navigation target is oriented "
"up."
msgstr "Flytter kortværktøjet så navigationsmålet orienteres op."

#, no-c-format
msgid "Wind up"
msgstr "Vind op"

#, no-c-format
msgid ""
"The moving map display will be rotated so the wind is always oriented up to "
"down. (can be useful for wave flying)"
msgstr ""
"Flytter kortværktøjet så vindstyrken altid orienteres op og ned. (kan være "
"nyttigt for vaveflyvning)"

#, no-c-format
msgid "Disable adjustments."
msgstr "Deaktiver justeringer."

#, no-c-format
msgid "Track"
msgstr "Rute"

#, no-c-format
msgid "Use a recent average of the ground track as basis."
msgstr "Brug nylig gennemsnit af jordens rute som basis."

#, no-c-format
msgid "Target"
msgstr "Mål"

#, no-c-format
msgid "Use the current target waypoint as basis."
msgstr "Brug nuværende målvejpunkt som basis."

msgid "Cruise orientation"
msgstr "Cruisedirektion"

msgid "Determines how the screen is rotated with the glider"
msgstr "Bestemmer, hvordan skærmen roteres med svæveflyet"

msgid "Circling orientation"
msgstr "Ringfledtide"

msgid "Determines how the screen is rotated with the glider while circling"
msgstr "Bestemmer, hvordan skærmen roteres med svæveflyet under ringflug"

msgid "Circling zoom"
msgstr "Ringfledezoom"

msgid ""
"If enabled, then the map will zoom in automatically when entering circling "
"mode and zoom out automatically when leaving circling mode."
msgstr ""
"Hvis aktiveret, zoomer kort automatisk ind, når du starter ringflug og ud, "
"når du slutter ringflug."

msgid "Map shift reference"
msgstr "Kartoverskydningsoverkilde"

msgid "Determines what is used to shift the glider from the map center"
msgstr ""
"Bestemmer, hvad der bruges til at flytte svæveflyet fra kartets centrum"

msgid "Glider position offset"
msgstr "Flytillstandsoffset"

msgid ""
"Defines the location of the glider drawn on the screen in percent from the "
"screen edge."
msgstr ""
"Definerer placeringen af svæveflyet på skærmen i procent relativt "
"skærmskantene."

msgid "Max. auto zoom distance"
msgstr "Maksimal automatisk zoomdistans"

msgid "The upper limit for auto zoom distance."
msgstr "Den højre grænse for automatisk zoomdistans."

msgid "Distinct page zoom"
msgstr "Enkeltpåskærmszoom"

msgid "Maintain one map zoom level on each page."
msgstr "Hold en konstant kartzoom på hver side."

#, no-c-format
msgid "Map (north-up)"
msgstr "Kort (nord-op)"

msgid "Main area"
msgstr "Hovedområde"

msgid "Specifies what should be displayed in the main area."
msgstr "Angiver, hvad der skal vises i hovedområdet."

#, no-c-format
msgid "Displays either the Circling, Cruise, or Final glide InfoBoxes."
msgstr "Viser enten Ringflug, Cruisedirektion eller Slutflyvning InfoBoxes."

#, no-c-format
msgid "Show fullscreen (no InfoBoxes)"
msgstr "Vis fuldskærm (ingen InfoBoxes)"

msgid "InfoBoxes"
msgstr "Infobox"

msgid "Specifies which InfoBoxes should be displayed on this page."
msgstr "Angiver, hvilke InfoBoxes der skal vises på denne side."

#, no-c-format
msgid "For cruise mode. Displayed when 'Auto' is selected and glider is below final glide altitude."
msgstr "For kryos mode. Vises når 'Auto' er valgt og svæveflytet ligger nederst foran slutglid."

#, no-c-format
msgid "For circling mode. Displayed when 'Auto' is selected and glider is circling."
msgstr "For ringeflyvning mode. Vises når 'Auto' er valgt og svæveflytet ringeflyver."

#, no-c-format
msgid "For final glide mode. Displayed when 'Auto' is selected and glider is above final glide altitude."
msgstr "For slutglid mode. Vises når 'Auto' er valgt og svæveflytet ligger over slutglid."

#, no-c-format
msgid "A custom InfoBox set"
msgstr "En brugermaskine for InfoBox"

#, no-c-format
msgid "Nothing"
msgstr "Intet"

#, no-c-format
msgid "Cross section"
msgstr "Sechnitt"

msgid "Bottom area"
msgstr "Nederste område"

#, no-c-format
msgid "Neither airspace nor terrain is used for route planning."
msgstr "Begge flytrappe og terrain bruges ikke til ruteplanlægning."

#, no-c-format
msgid "Routes will avoid terrain."
msgstr "Routerne vil undgå terrain."

#, no-c-format
msgid "Routes will avoid airspace."
msgstr "Routerne vil undgå flytrappe."

#, no-c-format
msgid "Routes will avoid airspace and terrain."
msgstr "Routerne vil undgå flytrappe og terrain."

msgid "Route mode"
msgstr "Rute modus"

msgid "Route climb"
msgstr "Rute stijl"

msgid ""
"When enabled and MC is positive, route planning allows climbs between the "
"aircraft location and destination."
msgstr ""
"Når aktiveret og MC er positivt, tillader ruteplanlægning stijninger mellem "
"flytrappeplaceringen og destinationen."

msgid "Route ceiling"
msgstr "Rute vinder"

msgid ""
"When enabled, route planning climbs are limited to ceiling defined by "
"greater of current aircraft altitude plus 500 m and the thermal ceiling. If "
"disabled, climbs are unlimited."
msgstr ""
"Når aktiveret, begrænser ruteplanlægningens stiger til den højeste af "
"nuværende flyhøjde plus 500 m og termikkenes vinder. Hvis deaktiveret, er "
"stiger ubegrænset."

#, no-c-format
msgid "Reach calculations disabled."
msgstr "Beregningsmuligheder for ankomst deaktiveret."

#, no-c-format
msgid "Straight"
msgstr "Retning"

#, no-c-format
msgid "The reach is from straight line paths from the glider."
msgstr "Reachen er fra rettede linjer fra svæveflytet."

#, no-c-format
msgid "Turning"
msgstr "Vending"

#, no-c-format
msgid "The reach is calculated allowing turns around terrain obstacles."
msgstr "Genstanden beregnes med vendsmuligheder omkring reliefskaber."

#. Spacer
msgid "Reach mode"
msgstr "Genstandsmode"

msgid ""
"How calculations are performed of the reach of the glider with respect to "
"terrain."
msgstr ""
"Hvordan beregninger udføres af svæveflens genstand med hensyn til relief."

#, no-c-format
msgid "Uses task glide polar."
msgstr "Bruger opgaveglid polar."

#, no-c-format
msgid "Safety MC"
msgstr "Sikkerhed MC"

#, no-c-format
msgid "Uses safety MacCready value."
msgstr "Bruger sikkerheds MacCready-værdi."

msgid "Reach polar"
msgstr "Genstandspolar"

msgid ""
"This determines the glide performance used in reach, landable arrival, abort "
"and alternate calculations."
msgstr ""
"Dette bestemmer glidefremkommelsen, der bruges i genstand, landbar ankomst, "
"afslag og alternativ beregninger."

#, no-c-format
msgid "Disables the reach display."
msgstr "Deaktiverer genstandsdisplayet."

#, no-c-format
msgid "Terrain line"
msgstr "Terrænlinje"

#, no-c-format
msgid "Draws a dashed line at the terrain glide reach."
msgstr "Tegner en punktlig linje ved genstandsgrænsen for svig."

#, no-c-format
msgid "Terrain shade"
msgstr "Terrænskygge"

#, no-c-format
msgid "Shades terrain outside glide reach."
msgstr "Skærmer relief udenfor genstandsgvigrænsen."

#, no-c-format
msgid "Working line"
msgstr "Arbejdslinje"

#, no-c-format
msgid "Draws a dashed line at the working glide reach."
msgstr "Tegner en punktlig linje ved arbejdsgvigrænsen."

#, no-c-format
msgid "Working line, terrain line"
msgstr "Arbejdslinje, reliefskaber"

#, no-c-format
msgid "Draws a dashed line at the working and terrain glide reaches."
msgstr "Tegner en punktlig linje ved arbejdsgvigrænsen og reliefskaber."

#, no-c-format
msgid "Working line, terrain shade"
msgstr "Arbejdslinje, reliefskaber, skærming"

#, no-c-format
msgid "Draws a dashed line at working, and shade terrain, glide reaches."
msgstr ""
"Tegner en punktlig linje ved arbejdsgvigrænsen og skærmer relief udenfor "
"sviggrænsen."

msgid "Reach display"
msgstr "Genstandsdisplay"

msgid "Arrival height"
msgstr "Ankommethøjde"

msgid ""
"The height above terrain that the glider should arrive at for a safe landing."
msgstr "Højden over terrain, der svæveflyet skal nå for en sikker udelanding."

msgid "Terrain height"
msgstr "Terrainhøjde"

msgid "The height above terrain that the glider must clear during final glide."
msgstr "Højden over terrain, der svæveflyet skal klare under slutglid."

#, no-c-format
msgid "Simple"
msgstr "Enkel"

#, no-c-format
msgid "Home"
msgstr "Hjem"

msgid "Alternates mode"
msgstr "Alternater tilstand"

msgid ""
"Determines sorting of alternates in the alternates dialog and in abort mode."
msgstr ""
"Bestemmer sorteringsmetoden for alternater i alternater dialog og "
"afbrydelsesmodus."

msgid "Polar degradation"
msgstr "Polar degradering"

#, no-c-format
msgid ""
"A permanent polar degradation. 0% means no degradation, 50% indicates the "
"glider's sink rate is doubled."
msgstr ""
"En permanent polar degradering. 0% betyder ingen degradering, 50% indikerer "
"at glidernes sinkrate dobbeltes."

msgid "Auto bugs"
msgstr "Automatisk bugsering"

#, no-c-format
msgid ""
"If enabled, adds 1% to the bugs setting after each full hour while flying."
msgstr ""
"Hvis aktiveret, tilføjes 1 % til fejlindstillingen efter hver hele time, "
"mens du flyver."

msgid ""
"The MacCready setting used, when safety MC is enabled for reach "
"calculations, in task abort mode and for determining arrival altitude at "
"airfields."
msgstr ""
"MacCready-indstillingen brugt, når sikkerhedsmacCready er aktiveret for "
"beregninger af opgaveafslutning, i afbrydelsesmodus og til at bestemme "
"ankomsthøjde ved luftfærdigheder."

msgid "STF risk factor"
msgstr "STF-riskfaktor"

msgid ""
"The STF risk factor reduces the MacCready setting used to calculate speed to "
"fly as the glider gets low, in order to compensate for risk. Set to 0.0 for "
"no compensation, 1.0 scales MC linearly with current height (with reference "
"to height of the maximum climb). If considered, 0.3 is recommended."
msgstr ""
"STF-riskfaktoren reducerer MacCready-indstillingen brugt til beregning af "
"hastighed at flyve, da glidernes højde falder, for at kompensere for "
"risikoen. Sat til 0.0 for ingen kompensation, 1.0 skalierer MC lineært med "
"nuværende højde (med reference til højden af den maksimale stigning). Hvis "
"overvejet, anbefales 0.3."

msgid "XCSoar data path"
msgstr "XCSoar datasti"

msgid "Click to view full path"
msgstr "Klik for at vise fuldsti"

msgid "Map database"
msgstr "Kartodatabase"

msgid "The name of the file (.xcm) containing terrain, topography, and optionally waypoints, their details and airspaces."
msgstr "Navn på filen (.xcm) der indeholder terrain, topografi og muligvis waypoints, detaljer og luftområder."

msgid "Watched WPTs"
msgstr "Så WPT'er"

msgid "Waypoint files containing special waypoints for which additional computations like calculation of arrival height in map display always takes place. Useful for waypoints like known reliable thermal sources (e.g. powerplants) or mountain passes."
msgstr "Waypoint-filer med specielle waypoints, hvor beregninger som beregning af ankomsthøjde i kartvisning altid tager plads. Nyttefuld for waypoints som kendte, relaterede thermalskilder (f.eks. elektriske centraler) eller fjordspasser."

msgid "WPT A/F details"
msgstr "WPT A/F detaljer"

msgid "The files may contain extracts from enroute supplements or other contributed information about individual waypoints and airfields."
msgstr "Filene kan indeholde udfra en route supplément eller anden bidragsydelser om individuelle waypoints og landebaner."

msgid "FLARM database"
msgstr "FLARM-radar"

msgid "The name of the file containing information about registered FLARM devices."
msgstr "Navn på filen der indeholder informationer om registrerede FLARM-enheder."

msgid "Regional Atmospheric Soaring Prediction file providing weather forecasts for soaring. Displays color-coded map overlays for thermal strength, boundary layer winds, cloud cover, and other soaring-relevant parameters at various forecast times throughout the day."
msgstr "Regional Atmosfærisk Soaring Prediction-fil, der giver vejrudsigter for skyhøje. Viser farvekodede kortoverlejringer for termisk styrke, grænselagsvinde, skydække og andre skyhøje-relevante parametre på forskellige prognosetidspunkter i løbet af dagen."

msgid "The checklist file containing pre-flight and other checklists."
msgstr "Tjeklistefilen, der indeholder pre-flight og andre tjeklister."

#, no-c-format
msgid "Disable display of ground track line."
msgstr "Deaktiver visning af jordsporlinje."

#, no-c-format
msgid "Always display ground track line."
msgstr "Vis altid jordsporlinje."

#, no-c-format
msgid ""
"Display ground track line if there is a significant difference to plane "
"heading."
msgstr "Vis jordsporlinje hvis der er en betydelig forskel til flykurs."

#, no-c-format
msgid "Vario #1"
msgstr "Variometer #1"

#, no-c-format
msgid ""
"Within lift areas lines get displayed green and thicker, while sinking lines "
"are shown brown and thin. Zero lift is presented as a grey line."
msgstr ""
"I løftesområder vises linjer grønne og tyngere, mens sanktioner vises brune "
"og smidige. Nullløft er repræsenteret som en grå linje."

#, no-c-format
msgid "Vario #1 (with dots)"
msgstr "Variometer #1 (med punkt)"

#, no-c-format
msgid ""
"The same colour scheme as the previous, but with dotted lines while sinking."
msgstr "Samme farver som i forrige, men med smidige linjer mens sanktioner."

#, no-c-format
msgid "Vario #2"
msgstr "Variometer #2"

#, no-c-format
msgid ""
"The climb colour for this scheme is orange to red, sinking is displayed as "
"light blue to dark blue. Zero lift is presented as a yellow line."
msgstr ""
"Løftefarve for denne skema er orange til rød, sanktioner vises som lysblå "
"til mørk blå. Nullløft er repræsenteret som en gyllen linje."

#, no-c-format
msgid "Vario #2 (with dots)"
msgstr "Variometer #2 (med punkt)"

#, no-c-format
msgid "Vario-scaled dots and lines"
msgstr "Variometerskalerede punkter og linjer"

#, no-c-format
msgid ""
"Vario-scaled dots with lines. Orange to red = climb. Light blue to dark blue "
"= sink. Zero lift is presented as a yellow line."
msgstr ""
"Vario-skalerede punkter med linjer. Orange til rød = stigning. Lyserødt til "
"mørkblå = fald. Nullløft er præsenteret som en gulerække."

#, no-c-format
msgid "Vario E-ink"
msgstr "Vario E-påvirkning"

#, no-c-format
msgid ""
"E-ink friendly color scheme, lighter and thicker dots means lift while "
"darker and thinner means sink."
msgstr ""
"E-ink venlig til at se farver, lysere og tyngre punkter betyder løftet, mens "
"mørre og smiddere betyder fald."

#, no-c-format
msgid "The colour scheme corresponds to the height."
msgstr "Farvearkivet korresponderer med højden."

#, no-c-format
msgid "Simplified line graphics, black with white contours."
msgstr "Enkel linjegrænsegrafik, sort med hvit kant."

#, no-c-format
msgid "Simple (large)"
msgstr "Enkel (stort)"

#, no-c-format
msgid "Enlarged simple graphics."
msgstr "Størret enkel grafik."

#, no-c-format
msgid "Detailed"
msgstr "Detailerede"

#, no-c-format
msgid "Detailed rendered aircraft graphics."
msgstr "Detailerede renderede flygrafikker."

#, no-c-format
msgid "HangGlider"
msgstr "Svævefly"

#, no-c-format
msgid "Simplified hang glider as line graphics, white with black contours."
msgstr "Enkel svæveflugt som linjegráfik, hvit med sorte kanter."

#, no-c-format
msgid "Simplified para glider as line graphics, white with black contours."
msgstr "Enkel paraflugt som linjegráfik, hvit med sorte kanter."

#, no-c-format
msgid "No wind arrow is drawn."
msgstr "Ingen vindpil tegnes."

#, no-c-format
msgid "Arrow head"
msgstr "Piltop"

#, no-c-format
msgid "Draws an arrow head only."
msgstr "Tegner kun en piltop."

#, no-c-format
msgid "Full arrow"
msgstr "Fuld pil"

#, no-c-format
msgid "Draws an arrow head with a dashed arrow line."
msgstr "Tegner en piltop med et tænkt linje."

#, no-c-format
msgid "Symbol"
msgstr "Symbol"

#, no-c-format
msgid "Symbol and Name"
msgstr "Ikon og Navn"

msgid "Ground track"
msgstr "Jordspor"

msgid "Display the ground track as a grey line on the map."
msgstr "Vis jordsporet som grå linje på kortet."

msgid "This enables the display of FLARM traffic on the map window."
msgstr "Dette aktiverer visning af FLARM trafik i kartvinduet."

msgid "Fade traffic"
msgstr "Udton trafik"

msgid "Keep showing traffic for a while after it has disappeared."
msgstr "Fortsæt at vise trafik en stedhøjde efter den har forsvundet."

msgid "Trail length"
msgstr "Sporlængde"

msgid ""
"Determines whether and how long a snail trail is drawn behind the glider."
msgstr "Bestemmer, om og hvor længe en snail trail tegnes baganvælget."

msgid "Trail type"
msgstr "Sportype"

msgid "Sets the type of the snail trail display."
msgstr "Angiver type af snail trail visning."

msgid "Trail scaled"
msgstr "Spor skaliert"

msgid ""
"If set to ON the snail trail width is scaled according to the vario signal."
msgstr ""
"Hvis sat til ON skalbredden for snail trail skaleres efter variometer signal."

msgid "Detour cost markers"
msgstr "Avrigelseskostnadsmerker"

msgid ""
"If the aircraft heading deviates from the current waypoint, markers are "
"displayed at points ahead of the aircraft. The value of each marker is the "
"extra distance required to reach that point as a percentage of straight-line "
"distance to the waypoint."
msgstr ""
"Hvis flyretning devierer fra nuværende vejpunkt, vises merker for punkter "
"foran flyet. Værdien af hver mærke er den ekstra distancen krævet til at nå "
"det punkt som procentdel af retlinejede afstand til vejpunktet."

msgid "Aircraft symbol"
msgstr "Flyikon"

#, no-c-format
msgid "Wind arrow"
msgstr "Vindpil"

msgid "Determines the way the wind arrow is drawn on the map."
msgstr "Angiver, hvordan vindpilen tegnes på kartet."

msgid "Start max. speed"
msgstr "Start maksimal hastighed"

msgid "Maximum speed allowed in start observation zone. Set to 0 for no limit."
msgstr ""
"Maksimal tilladte hastighed i startobservationstrækket. Indstil til 0 for "
"ingen grænse."

msgid "Start max. speed margin"
msgstr "Startmargen for maksimal hastighed"

msgid ""
"Maximum speed above maximum start speed to tolerate. Set to 0 for no "
"tolerance."
msgstr ""
"Maksimal tolereret hastighed over maksimale starthastigheder. Indstil til 0 "
"for ingen tolerans."

msgid "Start max. height"
msgstr "Startmaksimumshøjde"

msgid ""
"Maximum height based on start height reference (AGL or MSL) while starting "
"the task. Set to 0 for no limit."
msgstr ""
"Maksimal højde baseret på starthøjhedsindeks (AGL eller MSL) under "
"startstrækket. Indstil til 0 for ingen grænse."

msgid "Start max. height margin"
msgstr "Startmargen over maksimale starthøjder"

msgid ""
"Maximum height above maximum start height to tolerate. Set to 0 for no "
"tolerance."
msgstr ""
"Tolereret højde over maksimal starthøjde. Indstil til 0 for ingen tolerans."

#, no-c-format
msgid "Reference is the height above the task point."
msgstr "Referencen er højden over opgavepunktet."

#, no-c-format
msgid "Reference is altitude above mean sea level."
msgstr "Referencen er højden ovenfor mean sea level (MSL)."

msgid "Start height ref."
msgstr "Starthøjhedsindeks"

msgid "Reference used for start max height rule."
msgstr "Indeks brugt for startmaksimumshøjde-reglen."

msgid "Finish min. height"
msgstr "Slutminimumshøjde"

msgid ""
"Minimum height based on finish height reference (AGL or MSL) while finishing "
"the task. Set to 0 for no limit."
msgstr ""
"Maksimal højde baseret på sluthøjhedsindeks (AGL eller MSL) under "
"afslutningstrækket. Indstil til 0 for ingen grænse."

msgid "Finish height ref."
msgstr "Sluthøjhedsindeks"

msgid "Reference used for finish min height rule."
msgstr "Indeks brugt for slutmaksimumshøjde-reglen."

msgid "PEV start wait time"
msgstr "PEV-startventeretid"

msgid ""
"Wait time in minutes after Pilot Event and before start gate opens. 0 means "
"start opens immediately."
msgstr ""
"Ventetid i minutter efter Pilot Event og før startporten åbner. 0 betyder, "
"at starten åbner umiddelbart."

msgid "PEV start window"
msgstr "PEV-startvindue"

msgid ""
"Number of minutes start remains open after Pilot Event and PEV wait time.0 "
"means start will never close after it opens."
msgstr ""
"Antal minutter startbeholdes åben efter Pilot Event og PEV-vartetid.0 "
"betyder at start aldrig vil lukke efter den åbner."

#, no-c-format
msgid "Gate width"
msgstr "Portbredde"

#, no-c-format
msgid "Radius"
msgstr "Radius"

msgid "Default start type for new tasks you create."
msgstr "Standard starttype for nye opgaver du opretter."

msgid "Default radius or gate width of the start zone for new tasks."
msgstr "Standard radius eller portbredde af startområdet for nye opgaver."

msgid "Finish point"
msgstr "Slutpunkt"

msgid "Default finish type for new tasks you create."
msgstr "Standard sluttype for nye opgaver du opretter."

msgid "Default radius or gate width of the finish zone in new tasks."
msgstr "Standard radius eller portbredde af slutområdet i nye opgaver."

msgid "Turn point"
msgstr "Vendepunkt"

msgid "Default turn point type for new tasks you create."
msgstr "Standard vendepunkts-type for nye opgaver du opretter."

msgid "Default radius of turnpoint cylinders and sectors in new tasks."
msgstr "Standard radius af vendekegler og sektorer i nye opgaver."

msgid "Default task type for new tasks you create."
msgstr "Standard opgavetype for nye opgaver du opretter."

msgid "AAT min. time"
msgstr "AAT minimumstid"

msgid "Default AAT min. time for new AAT tasks."
msgstr "Standard AAT minimumstid for nye AAT-opgaver."

msgid "Optimisation margin"
msgstr "Optimeringsmargen"

msgid ""
"Safety margin for AAT task optimisation. Optimisation seeks to complete the "
"task at the minimum time plus this margin time."
msgstr ""
"Sikkerhedsmargin til AAT-opgaveoptimering. Optimeringen søger at gennemføre "
"opgaven på den mindste tid plus denne marginstid."

#, no-c-format
msgid "Disable contest calculations"
msgstr "Deaktiver konkurrenceskæring"

#, no-c-format
msgid "Conforms to FAI triangle rules. Three turns and common start and finish. No leg less than 28% of total except for tasks longer than 500km: No leg less than 25% or larger than 45%."
msgstr "I overensstemmelse med FAI trekant regler. Tre omgange og fælles start og mål. Intet ben mindre end 28% af det samlede antal undtagen for opgaver længere end 500 km: Intet ben mindre end 25% eller større end 45%."

#, no-c-format
msgid "Up to seven points including start and finish, finish height must not be lower than start height less 1000 meters."
msgstr "Op til syv punkter inklusive start og slutpunkt, højden ved slut skal ikke være lavere end starthøjden minus 1000 meter."

#, no-c-format
msgid "The most recent contest with Sprint task rules."
msgstr "Den mest nylige konkurrence med Sprint-opgave-regler."

#, no-c-format
msgid "A combination of Classic and FAI rules. 30% of the FAI score are added to the Classic score."
msgstr "En kombination af klassiske og FAI-regler. 30 % af FAI-resultatet lægges til Classic-resultatet."

#, no-c-format
msgid "PG online contest with different track values: Free flight - 1 km = 1.0 point; flat triangle - 1 km = 1.2 p; FAI triangle - 1 km = 1.4 p."
msgstr "En online-konkurrence med forskellige spår: Fri flyvning - 1 km = 1,0 point; flade trekant - 1 km = 1,2 p; FAI-trekant - 1 km = 1,4 p."

#, no-c-format
msgid "European PG online contest of the DHV organization. Pretty much the same as the XContest rules, but with different track values: 1 km = 1.5 points, 1.75 p and 2.0 p for FAI triangles respectively."
msgstr "En europæisk online-konkurrence af DHV-organisationen. Praktisk det samme som XContest-reglerne, men med forskellige spår-værdier: 1 km = 1,5 point, 1,75 p og 2,0 p for FAI-trekanterne."

#, no-c-format
msgid "Austrian online glider contest. Tracks around max. six waypoints are scored. The bounding box part with 1 km = 1.0 point and the additional zick-zack part with 1 km = 0.5 p."
msgstr ""
"Østrigsk online-svæveflykonkurrence. Ruter omkring maks. seks waypoints "
"scores. Bounding box-delen med 1 km = 1,0 point og den ekstra zigzag-del med"
" 1 km = 0,5 p."

#, no-c-format
msgid "WeGlide combines multiple scoring systems in the WeGlide Free contest. The free score is a combination of the free distance score and the area bonus. For the area bonus, the scoring program determines the largest FAI triangle and the largest Out & Return distance that can be fitted into the flight route."
msgstr ""
"WeGlide kombinerer flere scoringssystemer i WeGlide Free-konkurrencen. Free-"
"scoren er en kombination af freestyle-distancescoren og områdebonus. For "
"områdebonus finder scoringsprogrammet den største FAI-trekant og den største"
" Out & Return-distance, der kan indpasses i flyveruten."

#, no-c-format
msgid "A start point, one turn point and a finish point are chosen from the flight path such that the distance between the start point and the turn point is maximized."
msgstr ""
"Et startpunkt, et vendepunkt og et målpunkt vælges fra flyveruten, så "
"afstanden mellem startpunktet og vendepunktet maksimeres."

#, no-c-format
msgid "LVZC Charron.online, 5 legs under 200km 6 legs above. Minimum leg distance is 20km, 5 points per km."
msgstr ""
"LVZC Charron.online, 5 ben under 200 km, 6 ben derover. Mindste bendistance "
"er 20 km, 5 point pr. km."

msgid "Contest"
msgstr "Konkurrence"

msgid "Select the rules used for calculating optimal points for a contest."
msgstr "Vælg reglerne der bruges til beregning af optimale punkter for en konkurrence."

msgid "Predict Contest"
msgstr "Foreprognose Konkurrence"

msgid "If enabled, then the next task point is included in the score calculation, assuming that you will reach it."
msgstr "Hvis aktiveret, inkluderer næste opgavepunkt i poengsberegningen, antageligt at du vil nå det."

msgid "FAI triangle areas"
msgstr "FAI-trekantområder"

msgid "Show FAI triangle areas on the map."
msgstr "Vis FAI-trekantområder på kartet."

msgid "FAI triangle threshold"
msgstr "FAI-trekantgrænse"

msgid "Specifies which threshold is used for \"large\" FAI triangles."
msgstr "Angiver hvilken grænse der bruges til \"store\" FAI-trekant."

#, no-c-format
msgid "95% dist. rule helpers"
msgstr "95% dist. regel hjælper"

msgid "Show helpers for Argentinean Federation \"95% distance\" rule. The AAT Distance Around Target InfoBox will show projected distance vs. maximum and change colors as you approach 95%."
msgstr "Vis hjælp for Argentine Federations \"95% distance\" regel. AAT Distance Around Target InfoBox vil vise projicerede afstand mod maksimum og ændre farve med tiden, når du nærmer dig 95%."

msgid "Draw a digital elevation terrain on the map."
msgstr "Tegn et digitalt højdeprofil overflade på kartet."

msgid "Topography display"
msgstr "Topografivisning"

msgid "Draw topographical features (roads, rivers, lakes etc.) on the map."
msgstr "Tegn topografiske funktioner (veje, floder, søer m.m.) på kortet."

#, no-c-format
msgid "Low lands"
msgstr "Nedlande"

#, no-c-format
msgid "Mountainous"
msgstr "Bjergige"

#, no-c-format
msgid "Imhof 7"
msgstr "Imhof 7"

#, no-c-format
msgid "Imhof 4"
msgstr "Imhof 4"

#, no-c-format
msgid "Imhof 12"
msgstr "Imhof 12"

#, no-c-format
msgid "Imhof Atlas"
msgstr "Imhof Atlas"

#, no-c-format
msgid "ICAO"
msgstr "ICAO"

#, no-c-format
msgid "Vibrant"
msgstr "Vivd"

#, no-c-format
msgid "Grey"
msgstr "Grå"

#, no-c-format
msgid "White"
msgstr "Hvid"

#, no-c-format
msgid "Sandstone"
msgstr "Sandstein"

#, no-c-format
msgid "Pastel"
msgstr "Pastel"

#, no-c-format
msgid "Italian Avioportolano VFR Chart"
msgstr "Italiensk Avioportolano VFR Kort"

#, no-c-format
msgid "German DFS VFR Chart"
msgstr "Tysk DFS VFR Kort"

#, no-c-format
msgid "French SIA VFR Chart"
msgstr "Fransk SIA VFR Kort"

#, no-c-format
msgid "High Contrast"
msgstr "Høj kontrast"

#, no-c-format
msgid "High Contrast low lands"
msgstr "Høj kontrast nedlande"

#, no-c-format
msgid "Very low lands"
msgstr "Rart nedlande"

msgid "Terrain colors"
msgstr "Terrainfarver"

msgid "Defines the color ramp used in terrain rendering."
msgstr "Definerer farvegradsmodellen brugt i terrainvisning."

#, no-c-format
msgid "Sun"
msgstr "Sol"

msgid "Slope shading"
msgstr "Hyllerundertrykning"

msgid "Terrain contrast"
msgstr "Hyllerskarpemal"

msgid "Defines the amount of Phong shading in the terrain rendering. Use large values to emphasise terrain slope, smaller values if flying in steep mountains."
