msgstr "Vis tekst i tabbed dialoger."

#, no-c-format
msgid "Icons"
msgstr "Ikoner"

#, no-c-format
msgid "Show icons on tabbed dialogs."
msgstr "Vis ikoner i tabbed dialoger."

#, no-c-format
msgid "Center"
msgstr "Centreret"

#, no-c-format
msgid "Center the status message boxes."
msgstr "Center de statusmeddelelsesboksen."

#, no-c-format
msgid "Show status message boxes in the top left corner."
msgstr "Vis statusmeddelelsesboksen i det venstre højre hjørne."

#, no-c-format
msgid "Box"
msgstr "Boks"

#, no-c-format
msgid "Draws boxes around each InfoBox."
msgstr "Tegner en boks omkring hvert InfoBox."

#, no-c-format
msgid "Tab"
msgstr "Tag"

#, no-c-format
msgid "Draws a tab at the top of the InfoBox across the title."
msgstr "Tegner et tag ved toppen af InfoBox over titlen."

