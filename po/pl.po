msgid "Preload Selected"
msgstr "Wczytaj wybrane"

msgid "Select SkySight Layers"
msgstr "Wybierz warstwy SkySight"

#, no-c-format
msgctxt "Button"
msgid "Select all"
msgstr "Wszystkie"

#, no-c-format
msgctxt "Button"
msgid "Select none"
msgstr "Żadne"

msgid "Some selected layers couldn't be added (the list may be full)."
msgstr ""
"Niektórych wybranych warstw nie udało się dodać (lista może być pełna)."

msgid "Couldn't preload forecast data."
msgstr "Nie udało się wstępnie załadować danych prognozy."

msgid "Couldn't apply the selected SkySight layer to the current page."
msgstr ""
"Nie udało się zastosować wybranej warstwy SkySight do bieżącej strony."

#, c-format
msgid "Cache %u forecast files for %u selected SkySight layers for offline use?"
msgstr ""
"Zapisać w pamięci %u plików prognozy dla %u wybranych warstw SkySight do "
"użytku offline?"

#, c-format
msgid "Discover and cache all forecasts for %u selected SkySight layers for offline use?"
msgstr ""
"Odkryć i zapisać wszystkie prognozy dla %u wybranych warstw SkySight do "
"użytku offline?"

msgid "SkySight offline cache"
msgstr "Pamięć offline SkySight"

#, c-format
msgid "%s in %u files"
msgstr "%s w %u plikach"

#, c-format
msgid "Delete %s of cached SkySight data? This includes any recently downloaded forecasts and map tiles. The active layer may be downloaded again if Auto update is enabled."
msgstr ""
"Usunąć %s danych SkySight z pamięci? Obejmuje niedawno pobrane prognozy i "
"kafelki mapy. Aktywna warstwa może zostać pobrana ponownie, jeśli włączona "
"jest autoaktualizacja."

msgid "Clear SkySight cache"
msgstr "Wyczyść pamięć SkySight"

#, c-format
msgid "Deleted %s in %u files."
msgstr "Usunięto %s w %u plikach."

msgid "Automatically download missing or newer SkySight data for the current map page. Manual preload remains available."
msgstr ""
"Automatycznie pobieraj brakujące lub nowsze dane SkySight dla bieżącej "
"strony mapy. Ręczne wstępne ładowanie pozostaje dostępne."

#, no-c-format
msgctxt "Setting"
msgid "Cache"
msgstr "Pamięć podręczna"

msgid "Total disk space used by the SkySight cache folder."
msgstr "Całkowite miejsce na dysku używane przez folder pamięci SkySight."

#, no-c-format
msgctxt "Button"
msgid "Clear downloaded data"
msgstr "Wyczyść dane"

msgid "SkySight is unavailable."
msgstr "SkySight jest niedostępny."

#, c-format
msgid "SkySight rate limit reached; continuing in %u seconds."
msgstr "Osiągnięto limit SkySight; kontynuacja za %u s."

msgid "SkySight downloads resumed."
msgstr "Wznowiono pobieranie SkySight."

msgid "Loading SkySight forecast steps..."
msgstr "Ładowanie kroków prognozy SkySight…"

#, c-format
msgid "SkySight forecasts: %u of %u available..."
msgstr "Prognozy SkySight: %u z %u dostępnych…"

#, c-format
msgid "SkySight rate limited; continuing in %u seconds..."
msgstr "SkySight ograniczony; kontynuacja za %u s…"

#, c-format
msgid "SkySight connection failed; retrying in %u seconds..."
msgstr "Połączenie SkySight nieudane; ponowienie za %u s…"

#, c-format
msgid "SkySight preload completed with %u failures."
msgstr "Wstępne ładowanie SkySight zakończone z %u błędami."

#, c-format
msgid "SkySight offline cache ready: %u files."
msgstr "Pamięć offline SkySight gotowa: %u plików."

#, c-format
msgid "SkySight cache finished: %u of %u files ready, %u failed."
msgstr "Pamięć SkySight zakończona: %u z %u plików gotowych, %u nieudanych."

