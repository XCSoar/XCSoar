msgstr "외기온도, 프로브 혹은 고성능 바리오에서 측정한 기체 외부의 온도."

#, no-c-format
msgid "Relative humidity"
msgstr "상대 습도"

#, no-c-format
msgid "Rel Hum"
msgstr "상대습도"

